{%- comment -%}
  ECA LP — inline icon set. Stroke icons (Lucide-style, MIT), currentColor so they inherit the theme.
  Usage: {% render 'eca-lp-icon', name: 'check', class: 'eca-lp-ico' %}
{%- endcomment -%}
{%- liquid
  assign n = name | default: 'check'
-%}
<svg class="{{ class | default: 'eca-lp-ico' }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case n -%}
    {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
    {%- when 'check-circle' -%}<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>
    {%- when 'star' -%}<path d="m12 3 2.6 5.6 6 .8-4.4 4.2 1.1 6L12 16.8 6.7 19.6l1.1-6L3.4 9.4l6-.8z"/>
    {%- when 'star-filled' -%}<path fill="currentColor" stroke="none" d="m12 2.5 2.8 6 6.5.9-4.7 4.6 1.1 6.5L12 17.4 6.3 20.5l1.1-6.5L2.7 9.4l6.5-.9z"/>
    {%- when 'star-half' -%}<path fill="currentColor" stroke="none" d="M12 2.5v14.9l-5.7 3.1 1.1-6.5L2.7 9.4l6.5-.9z"/><path d="m12 2.5 2.8 6 6.5.9-4.7 4.6 1.1 6.5L12 17.4"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
    {%- when 'bolt' -%}<path d="M13 2 4.5 13.5H11L10 22l9-11.5h-6.5z"/>
    {%- when 'shield' -%}<path d="M12 3l7 3v5.5c0 4.3-3 8-7 9.5-4-1.5-7-5.2-7-9.5V6z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'truck' -%}<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/>
    {%- when 'leaf' -%}<path d="M4 20c0-8 6-14 16-14 0 10-6 15-13 15-1 0-3-.4-3-1z"/><path d="M9 15c2-3 5-5 8-6"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-9.4A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.6c0 5-7 9.4-7 9.4z"/>
    {%- when 'sparkle' -%}<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M18 16.5 18.8 18.6 21 19.4l-2.2.8L18 22.5l-.8-2.3-2.2-.8 2.2-.8z"/>
    {%- when 'dollar' -%}<path d="M12 3v18"/><path d="M16.5 7.5c-.7-1.4-2.4-2-4.5-2-2.5 0-4 1.1-4 3s1.6 2.6 4 3.1 4.3 1.1 4.3 3.1-1.7 3.3-4.3 3.3c-2.3 0-4-.8-4.7-2.2"/>
    {%- when 'refresh' -%}<path d="M20 11a8 8 0 0 0-14-4.5L4 9"/><path d="M4 13a8 8 0 0 0 14 4.5L20 15"/><path d="M4 5v4h4M20 19v-4h-4"/>
    {%- when 'lock' -%}<rect x="4.5" y="10" width="15" height="10" rx="2"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10"/>
    {%- when 'package' -%}<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>
    {%- when 'smile' -%}<circle cx="12" cy="12" r="9"/><path d="M8.5 14c1 1.3 2.2 2 3.5 2s2.5-.7 3.5-2"/><path d="M9 9.5h.01M15 9.5h.01"/>
    {%- when 'award' -%}<circle cx="12" cy="9" r="5"/><path d="m8.5 13.5-1.5 7 5-2.5 5 2.5-1.5-7"/>
    {%- else -%}<path d="M20 6 9 17l-5-5"/>
  {%- endcase -%}
</svg>
