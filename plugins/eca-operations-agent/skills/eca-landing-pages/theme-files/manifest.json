    "eca-lp-guarantee.liquid",
    "eca-lp-hero-v2.liquid",
    "eca-lp-how-it-works.liquid",
    "eca-lp-in-the-box.liquid",
    "eca-lp-listicle.liquid",
    "eca-lp-offer-v2.liquid",
    "eca-lp-proof.liquid",
    "eca-lp-reviews-embed.liquid",
    "eca-lp-settings.liquid",
    "eca-lp-testimonials.liquid",
    "eca-lp-trust-bar.liquid",
    "eca-lp-visual-proof.liquid",
    "eca-lp-whats-included.liquid"
  ],
  "deprecated_do_not_install": [
    "eca-lp-hero.liquid",
    "eca-lp-offer.liquid"
  ],
  "snippets": [
    "eca-lp-cta.liquid",
    "eca-lp-icon.liquid",
    "eca-lp-placeholder.liquid"
