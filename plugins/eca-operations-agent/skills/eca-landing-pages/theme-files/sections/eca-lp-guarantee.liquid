{%- comment -%} ECA LP — Guarantee. Element 7: risk removal, in its own moment. {%- endcomment -%}
<section class="eca-lp-gar">
  <div class="eca-lp-wrap eca-lp-wrap--narrow eca-lp-gar__inner">
    {%- if section.settings.badge != blank -%}
      {{ section.settings.badge | image_url: width: 200 | image_tag: loading: 'lazy', class: 'eca-lp-gar__badge', alt: section.settings.heading }}
    {%- endif -%}
    <h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>
    <div class="eca-lp-gar__body">{{ section.settings.body }}</div>
    {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: blank, style: 'primary' %}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Guarantee", "tag": "section", "class": "eca-lp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "{{GUARANTEE — e.g. Try it for 30 days}}" },
    { "type": "richtext", "id": "body", "label": "Guarantee detail", "info": "What it is, how long, and how to claim. Plain language, no asterisks. Use the brand's real policy only.", "default": "<p>{{Explain the guarantee: what, how long, how to claim.}}</p>" },
    { "type": "image_picker", "id": "badge", "label": "Badge image (optional)" },
    { "type": "text", "id": "cta_label", "label": "Button text" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "ECA LP — Guarantee" }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-gar{padding:3.5rem 1.5rem}
.eca-lp-gar__inner{text-align:center;border:2px solid rgba(0,0,0,.1);border-radius:14px;padding:2.5rem 1.75rem}
.eca-lp-gar__badge{width:88px;height:auto;margin:0 auto 1rem;display:block}
.eca-lp-gar__body{line-height:1.7;opacity:.9;max-width:560px;margin:0 auto}
{% endstylesheet %}
