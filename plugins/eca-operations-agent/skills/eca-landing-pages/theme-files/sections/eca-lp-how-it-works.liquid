{%- comment -%} eca-lp-library v1.28.0 {%- endcomment -%}
{%- comment -%} ECA LP — How it works. Element 6: numbered steps. {%- endcomment -%}
{%- liquid
  assign eca_cls = ''
  if section.settings.color_scheme != blank
    assign eca_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign eca_sty = ''
  if section.settings.bg_color != blank
    assign eca_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign eca_sty = eca_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}
<section class="eca-lp-how {{ eca_cls }}" style="{{ eca_sty }}">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="eca-lp-how__grid">
      {%- for block in section.blocks -%}
        <div class="eca-lp-how__step" {{ block.shopify_attributes }}>
          <div class="eca-lp-how__num">{{ forloop.index }}</div>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'eca-lp-how__img', alt: block.settings.title }}
          {%- else -%}
            {% render 'eca-lp-placeholder', ratio: '4x3', label: 'Step image' %}
          {%- endif -%}
          <h3 class="eca-lp-how__title">{{ block.settings.title }}</h3>
          <div class="eca-lp-how__body">{{ block.settings.body }}</div>
        </div>
      {%- endfor -%}
    </div>
    {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: section.settings.risk_text, style: 'primary' %}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — How it works",
  "tag": "section",
  "class": "eca-lp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text",
      "default": ""
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "risk_text",
      "label": "Risk-removal line",
      "default": ""
    },
    {
      "type": "header",
      "content": "Section colour"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Uses your theme's colour schemes so text and buttons stay readable. Leave as-is to inherit the page."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)",
      "info": "Overrides the scheme. Only use if you need an exact colour."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text (optional)"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "{{STEP}}"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Step detail",
          "default": "<p>{{Plain, one-sentence instruction.}}</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "ECA LP — How it works",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
{% stylesheet %}
.eca-lp-how{padding:3.5rem 1.5rem;background:rgba(0,0,0,.02)}
.eca-lp-how__grid{display:grid;gap:2rem;margin-top:2rem}
@media(min-width:750px){.eca-lp-how__grid{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}}
.eca-lp-how__num{width:2.25rem;height:2.25rem;border-radius:999px;display:grid;place-items:center;font-weight:800;background:rgba(0,0,0,.08);margin-bottom:.75rem}
.eca-lp-how__img{width:100%;height:auto;border-radius:10px;margin-bottom:.75rem;display:block}
.eca-lp-how__title{margin:0 0 .5rem;font-size:1.1rem}
.eca-lp-how__body{opacity:.85;line-height:1.6}
.eca-lp-how .eca-lp-cta{text-align:center;margin-top:2.5rem}
.eca-lp-ph{position:relative;width:100%;overflow:hidden;border-radius:12px;background:rgba(127,127,127,.08);display:flex;align-items:center;justify-content:center;min-height:200px;color:currentColor}
.eca-lp-ph--16x9{aspect-ratio:16/9}
.eca-lp-ph--4x3{aspect-ratio:4/3}
.eca-lp-ph--1x1{aspect-ratio:1/1}
.eca-lp-ph__svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.eca-lp-ph__label{position:relative;font-size:.8rem;font-weight:600;opacity:.55;text-align:center;padding:.4rem .8rem;background:rgba(255,255,255,.75);border-radius:999px}
{% endstylesheet %}
