{%- comment -%}
  ECA LP — Page settings. Landing-page-wide options: sticky add-to-cart bar + hide site nav/footer.
  Add this section once per landing page (it renders no visible content of its own beyond the sticky bar).
{%- endcomment -%}

{%- if section.settings.hide_header or section.settings.hide_footer -%}
  <style>
    {%- if section.settings.hide_header -%}
      /* Hide site navigation for a distraction-free landing page */
      .shopify-section-group-header-group,
      #shopify-section-header, .section-header, header.header, .header-wrapper,
      .announcement-bar, .shopify-section-header, [id^="shopify-section-sections--"][id*="header"] { display: none !important; }
    {%- endif -%}
    {%- if section.settings.hide_footer -%}
      .shopify-section-group-footer-group,
      #shopify-section-footer, .section-footer, footer.footer, .footer-wrapper,
      [id^="shopify-section-sections--"][id*="footer"] { display: none !important; }
    {%- endif -%}
  </style>
{%- endif -%}

{%- assign p = section.settings.product -%}
{%- if section.settings.sticky_enabled and p != blank -%}
  <div class="eca-lp-sticky" id="eca-lp-sticky" data-show-after="{{ section.settings.show_after }}">
    <div class="eca-lp-sticky__inner">
      <div class="eca-lp-sticky__info">
        {%- if p.featured_image != blank -%}
          {{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'eca-lp-sticky__img', alt: p.title }}
        {%- endif -%}
        <div>
          <div class="eca-lp-sticky__title">{{ section.settings.sticky_title | default: p.title }}</div>
          <div class="eca-lp-sticky__price">
            {{ p.price | money }}
            {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
          </div>
        </div>
      </div>
      {%- form 'product', p, id: 'eca-lp-sticky-form', class: 'eca-lp-sticky__form' -%}
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
        <button type="submit" class="eca-lp-btn eca-lp-btn--primary eca-lp-sticky__btn" {% unless p.available %}disabled{% endunless %}>
          {%- if p.available -%}{{ section.settings.sticky_cta }}{%- else -%}Sold out{%- endif -%}
        </button>
      {%- endform -%}
    </div>
    {%- if section.settings.sticky_risk != blank -%}
      <p class="eca-lp-sticky__risk">{{ section.settings.sticky_risk }}</p>
    {%- endif -%}
  </div>
  <script>
    (function(){
      var bar = document.getElementById('eca-lp-sticky');
      if(!bar) return;
      var after = parseInt(bar.dataset.showAfter || '600', 10);
      var shown = false;
      function onScroll(){
        var y = window.scrollY || window.pageYOffset;
        if(y > after && !shown){ bar.classList.add('is-visible'); shown = true; }
        else if(y <= after && shown){ bar.classList.remove('is-visible'); shown = false; }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
{%- elsif section.settings.sticky_enabled and request.design_mode -%}
  <div class="eca-lp-appslot" style="margin:1.5rem">
    <p class="eca-lp-appslot__t">Pick a product for the sticky add-to-cart bar</p>
    <p class="eca-lp-appslot__d">Choose the product this landing page sells in this section's settings and the sticky bar will appear as visitors scroll.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ECA LP — Page settings",
  "tag": "section",
  "class": "eca-lp-settings",
  "settings": [
    { "type": "header", "content": "Distraction-free page" },
    { "type": "checkbox", "id": "hide_header", "label": "Hide site navigation", "info": "Removes the header/menu so there's only one way out of the page: your CTA. Standard for paid-traffic landing pages.", "default": false },
    { "type": "checkbox", "id": "hide_footer", "label": "Hide site footer", "info": "Also removes footer links. Keep the footer if you need policy links visible for ad platform compliance.", "default": false },
    { "type": "header", "content": "Sticky add to cart" },
    { "type": "checkbox", "id": "sticky_enabled", "label": "Show sticky add-to-cart bar", "default": true },
    { "type": "product", "id": "product", "label": "Product", "info": "The product this landing page sells." },
    { "type": "text", "id": "sticky_title", "label": "Bar title override", "info": "Leave blank to use the product title.", "default": "" },
    { "type": "text", "id": "sticky_cta", "label": "Button text", "default": "Add to cart" },
    { "type": "text", "id": "sticky_risk", "label": "Risk-removal line", "info": "Small line under the bar, e.g. 30-day money-back guarantee.", "default": "" },
    { "type": "range", "id": "show_after", "label": "Show after scrolling", "min": 200, "max": 2000, "step": 100, "unit": "px", "default": 600 }
  ],
  "presets": [{ "name": "ECA LP — Page settings" }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-sticky{position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgb(var(--color-background,255,255,255));border-top:1px solid rgba(0,0,0,.12);box-shadow:0 -2px 16px rgba(0,0,0,.08);padding:.75rem 1rem;transform:translateY(110%);transition:transform .25s ease;padding-bottom:calc(.75rem + env(safe-area-inset-bottom))}
.eca-lp-sticky.is-visible{transform:translateY(0)}
.eca-lp-sticky__inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:1rem}
.eca-lp-sticky__info{display:flex;align-items:center;gap:.75rem;min-width:0}
.eca-lp-sticky__img{width:44px;height:44px;object-fit:cover;border-radius:8px;flex:0 0 44px}
.eca-lp-sticky__title{font-weight:600;font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:38vw}
.eca-lp-sticky__price{font-size:.9rem;opacity:.8}
.eca-lp-sticky__price s{opacity:.5;margin-left:.35rem}
.eca-lp-sticky__form{margin:0;flex:0 0 auto}
.eca-lp-sticky__btn{border:none;cursor:pointer;padding:.75rem 1.5rem;font-size:.95rem;white-space:nowrap}
.eca-lp-sticky__risk{text-align:center;font-size:.75rem;opacity:.7;margin:.4rem 0 0}
@media(max-width:600px){.eca-lp-sticky__img{display:none}.eca-lp-sticky__title{max-width:45vw}}
{% endstylesheet %}
