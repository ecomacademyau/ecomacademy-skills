{%- comment -%} eca-lp-library v1.25.0 {%- endcomment -%}
{%- comment -%}
  ECA LP — Offer + buy. Block-based: badge, heading, price, variants, inventory,
  countdown, buy button, risk line and trust points are all movable blocks.
  Uses the theme's native product form so it's a real add-to-cart.
{%- endcomment -%}
{%- assign p = section.settings.product -%}
{%- assign v = p.selected_or_first_available_variant -%}
{%- if section.settings.default_variant != blank -%}
  {%- assign want_id = section.settings.default_variant | times: 1 -%}
  {%- for variant in p.variants -%}
    {%- if variant.id == want_id -%}{%- assign v = variant -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- liquid
  assign eca_cls = ''
  if section.settings.color_scheme != blank
    assign eca_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign eca_sty = ''
  if section.settings.bg_color != blank
    assign eca_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign eca_sty = eca_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}
<section class="eca-lp-offer {{ eca_cls }}" id="eca-lp-offer" style="{{ eca_sty }}">
  <div class="eca-lp-wrap eca-lp-offer__inner">
    <div class="eca-lp-offer__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: p.title | default: 'Product' }}
      {%- elsif p != blank -%}
        {{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'eca-lp-offer__pimg', alt: p.title }}
      {%- else -%}
        {% render 'eca-lp-placeholder', ratio: '1x1', label: 'Product image' %}
      {%- endif -%}
    </div>

    <div class="eca-lp-offer__copy" data-eca-offer>
      {%- form 'product', p, id: 'eca-lp-offer-form', class: 'eca-lp-offer__form' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-eca-variant-id>

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'badge' -%}
              {%- if block.settings.text != blank -%}
                <span class="eca-lp-offer__badge" {{ block.shopify_attributes }}
                  style="background:{{ block.settings.bg }};color:{{ block.settings.fg }}">{{ block.settings.text }}</span>
              {%- endif -%}

            {%- when 'heading' -%}
              <h2 class="eca-lp-h2 eca-lp-h2--left" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>

            {%- when 'text' -%}
              <div class="eca-lp-offer__body" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'price' -%}
              {%- if p != blank -%}
                <p class="eca-lp-offer__price" {{ block.shopify_attributes }}>
                  <span data-eca-price>{{ v.price | money }}</span>
                  <s class="eca-lp-offer__was" data-eca-compare{% unless v.compare_at_price > v.price %} hidden{% endunless %}>{{ v.compare_at_price | money }}</s>
                  {%- if block.settings.show_saving -%}
                    <span class="eca-lp-offer__save" data-eca-save{% unless v.compare_at_price > v.price %} hidden{% endunless %}>
                      {{- v.compare_at_price | minus: v.price | money -}} off</span>
                  {%- endif -%}
                </p>
              {%- endif -%}

            {%- when 'variants' -%}
              {%- if p != blank and p.variants.size > 1 -%}
                <div class="eca-lp-offer__variants" {{ block.shopify_attributes }}>
                  <label class="eca-lp-offer__vlabel" for="eca-lp-variant">{{ block.settings.label }}</label>
                  <select id="eca-lp-variant" class="eca-lp-offer__vselect" data-eca-variant-select>
                    {%- for variant in p.variants -%}
                      <option value="{{ variant.id }}"
                        {% if variant == v %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (sold out){% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}

            {%- when 'inventory' -%}
              {%- if p != blank -%}
                <p class="eca-lp-offer__inv" {{ block.shopify_attributes }} data-eca-inv
                   data-threshold="{{ block.settings.threshold }}"
                   data-low="{{ block.settings.low_text }}"
                   data-in="{{ block.settings.in_text }}"
                   data-out="{{ block.settings.out_text }}"></p>
              {%- endif -%}

            {%- when 'countdown' -%}
              {%- comment -%} shop_now anchors the timer to the STORE's timezone, not the visitor's {%- endcomment -%}
              <div class="eca-lp-offer__count" {{ block.shopify_attributes }}
                   data-eca-countdown
                   data-mode="{{ block.settings.mode }}"
                   data-end="{{ block.settings.end_at }}"
                   data-reset-time="{{ block.settings.reset_time }}"
                   data-reset-day="{{ block.settings.reset_day }}"
                   data-shop-now="{{ 'now' | date: '%Y-%m-%dT%H:%M:%S' }}"
                   data-expired="{{ block.settings.expired_text }}"
                   data-hide="{{ block.settings.hide_on_end }}">
                {%- if block.settings.label != blank -%}<span class="eca-lp-offer__clabel">{{ block.settings.label }}</span>{%- endif -%}
                <span class="eca-lp-offer__cvals" data-eca-countdown-vals></span>
              </div>

            {%- when 'buy' -%}
              <button type="submit" class="eca-lp-btn eca-lp-btn--primary eca-lp-offer__btn" {{ block.shopify_attributes }}
                data-eca-buy {% unless v.available %}disabled{% endunless %}>
                <span data-eca-buy-text>{%- if v.available -%}{{ block.settings.label }}{%- else -%}{{ block.settings.sold_out_label }}{%- endif -%}</span>
              </button>
              {%- if block.settings.show_dynamic -%}{{ form | payment_button }}{%- endif -%}

            {%- when 'risk' -%}
              {%- if block.settings.text != blank -%}
                <p class="eca-lp-cta__risk" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {%- endif -%}

            {%- when 'trust_points' -%}
              <ul class="eca-lp-offer__points" {{ block.shopify_attributes }}>
                {%- assign pts = block.settings.points | newline_to_br | split: '<br />' -%}
                {%- for pt in pts -%}{%- assign c = pt | strip -%}
                  {%- if c != blank -%}<li>{% render 'eca-lp-icon', name: block.settings.icon_name, class: 'eca-lp-offer__pico' %}<span>{{ c }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'spacer' -%}
              <div style="height:{{ block.settings.height }}px" {{ block.shopify_attributes }}></div>

            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>

          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}

      {%- if p == blank and request.design_mode -%}
        <div class="eca-lp-appslot"><p class="eca-lp-appslot__t">Choose a product</p>
        <p class="eca-lp-appslot__d">Pick the product this page sells in the section settings to enable price, variants, inventory and add-to-cart.</p></div>
      {%- endif -%}
    </div>
  </div>

  {%- if p != blank -%}
    <script type="application/json" data-eca-variants>
      [
      {%- for variant in p.variants -%}
        {%- liquid
          assign on_sale = false
          if variant.compare_at_price > variant.price
            assign on_sale = true
          endif
          assign tracked = false
          if variant.inventory_management != blank
            assign tracked = true
          endif
        -%}
        {"id":{{ variant.id }},"price":{{ variant.price | money | json }},"compare":{{ variant.compare_at_price | money | json }},"onSale":{{ on_sale }},"save":{{ variant.compare_at_price | minus: variant.price | money | json }},"available":{{ variant.available }},"qty":{{ variant.inventory_quantity | default: 0 }},"tracked":{{ tracked }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
      ]
    </script>
  {%- endif -%}
</section>

<script>
(function(){
  var root=document.getElementById('eca-lp-offer'); if(!root) return;
  var dataEl=root.querySelector('[data-eca-variants]');
  var variants=dataEl?JSON.parse(dataEl.textContent):[];
  var sel=root.querySelector('[data-eca-variant-select]');
  var idInput=root.querySelector('[data-eca-variant-id]');
  var priceEl=root.querySelector('[data-eca-price]'), cmpEl=root.querySelector('[data-eca-compare]'), saveEl=root.querySelector('[data-eca-save]');
  var invEl=root.querySelector('[data-eca-inv]'), buy=root.querySelector('[data-eca-buy]'), buyText=root.querySelector('[data-eca-buy-text]');
  function render(v){
    if(!v) return;
    if(idInput) idInput.value=v.id;
    if(priceEl) priceEl.textContent=v.price;
    if(cmpEl){ cmpEl.textContent=v.compare||''; cmpEl.hidden=!v.onSale; }
    if(saveEl){ saveEl.textContent=(v.save||'')+' off'; saveEl.hidden=!v.onSale; }
    if(buy){ buy.disabled=!v.available; if(buyText&&!v.available) buyText.textContent=buy.dataset.soldOut||'Sold out'; }
    if(invEl){
      var t=parseInt(invEl.dataset.threshold||'10',10);
      if(!v.available){ invEl.textContent=invEl.dataset.out||''; invEl.className='eca-lp-offer__inv is-out'; }
      else if(v.tracked && v.qty>0 && v.qty<=t){ invEl.textContent=(invEl.dataset.low||'Only {qty} left').replace('{qty}',v.qty); invEl.className='eca-lp-offer__inv is-low'; }
      else { invEl.textContent=invEl.dataset.in||''; invEl.className='eca-lp-offer__inv is-in'; }
    }
  }
  if(sel){ sel.addEventListener('change',function(){ render(variants.filter(function(x){return x.id==sel.value;})[0]); }); }
  render(variants.filter(function(x){return idInput && x.id==idInput.value;})[0]||variants[0]);

  var cd=root.querySelector('[data-eca-countdown]');
  if(cd){
    var out=cd.querySelector('[data-eca-countdown-vals]'), mode=cd.dataset.mode||'fixed';
    // Anchor to the STORE's clock: offset between shop time (rendered server-side) and this browser.
    var shopNow=new Date((cd.dataset.shopNow||'').replace(' ','T')).getTime();
    var skew=(!isNaN(shopNow)?shopNow-Date.now():0);
    var shopTime=function(){ return new Date(Date.now()+skew); };
    function parseHM(v,dh,dm){ var m=/^(\d{1,2}):(\d{2})$/.exec((v||'').trim()); return m?[+m[1],+m[2]]:[dh,dm]; }
    function target(){
      var now=shopTime();
      if(mode==='daily'||mode==='weekly'){
        var hm=parseHM(cd.dataset.resetTime,23,59);
        var t=new Date(now); t.setHours(hm[0],hm[1],0,0);
        if(mode==='weekly'){
          var want=parseInt(cd.dataset.resetDay||'5',10); // 0=Sun
          var add=(want-t.getDay()+7)%7;
          if(add===0 && t<=now) add=7;
          t.setDate(t.getDate()+add);
        } else if(t<=now){ t.setDate(t.getDate()+1); }
        return t.getTime();
      }
      var e=new Date((cd.dataset.end||'').replace(' ','T')).getTime();
      return isNaN(e)?NaN:e;
    }
    var end=target();
    if(isNaN(end)){ cd.style.display='none'; }
    else {
      var tick=function(){
        var d=end-(Date.now()+skew);
        if(d<=0){
          if(mode==='daily'||mode==='weekly'){ end=target(); return; }   // roll over, never expires
          if(cd.dataset.hide==='true'){cd.style.display='none';} else {out.textContent=cd.dataset.expired||'';}
          clearInterval(iv); return;
        }
        var dd=Math.floor(d/864e5), h=Math.floor(d%864e5/36e5), m=Math.floor(d%36e5/6e4), s=Math.floor(d%6e4/1e3);
        out.textContent=(dd>0?dd+'d ':'')+('0'+h).slice(-2)+'h '+('0'+m).slice(-2)+'m '+('0'+s).slice(-2)+'s';
      };
      tick(); var iv=setInterval(tick,1000);
    }
  }
})();
</script>
{% schema %}
{
  "name": "ECA LP — Offer + buy",
  "tag": "section",
  "class": "eca-lp-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Enables price, variants, inventory and native add-to-cart."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (defaults to product image)"
    },
    {
      "type": "text",
      "id": "default_variant",
      "label": "Default variant ID (optional)",
      "info": "Preselect a specific variant — e.g. build this page around one flavour or size. Find the ID in the product URL in Shopify admin (?variant=123456). Leave blank to use the first available variant."
    },
    {
      "type": "header",
      "content": "Section colour"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Uses your theme's colour schemes so text and buttons stay readable. Leave as-is to inherit the page."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)",
      "info": "Overrides the scheme. Only use if you need an exact colour."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text (optional)"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Sale / urgency badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "info": "Only claim what's true, e.g. 'Save 20%' or 'Ends Sunday'.",
          "default": ""
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "default": "#D0021B"
        },
        {
          "type": "color",
          "id": "fg",
          "label": "Text colour",
          "default": "#FFFFFF"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "{{THE OFFER}}"
        }
      ]
    },
    {
      "type": "text",
      "name": "Offer detail",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>{{What they get, plainly.}}</p>"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_saving",
          "label": "Show amount saved",
          "default": true
        }
      ]
    },
    {
      "type": "variants",
      "name": "Product variations",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Choose your option"
        }
      ]
    },
    {
      "type": "inventory",
      "name": "Inventory indicator",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "threshold",
          "label": "Low-stock threshold",
          "min": 1,
          "max": 50,
          "step": 1,
          "default": 10
        },
        {
          "type": "text",
          "id": "low_text",
          "label": "Low stock text",
          "info": "Use {qty} for the number.",
          "default": "Only {qty} left in stock"
        },
        {
          "type": "text",
          "id": "in_text",
          "label": "In stock text",
          "info": "Leave blank to show nothing when stock is healthy.",
          "default": "In stock, ships within 24 hours"
        },
        {
          "type": "text",
          "id": "out_text",
          "label": "Sold out text",
          "default": "Currently sold out"
        }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown timer",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Only ever count down to something real — a genuine offer deadline or a true daily/weekly cutoff (like your dispatch time). Fake urgency damages trust and can breach consumer law."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Order within"
        },
        {
          "type": "select",
          "id": "mode",
          "label": "Type",
          "options": [
            {
              "value": "fixed",
              "label": "Fixed deadline (one-off offer)"
            },
            {
              "value": "daily",
              "label": "Daily cutoff (resets every day)"
            },
            {
              "value": "weekly",
              "label": "Weekly cutoff (resets every week)"
            }
          ],
          "default": "daily",
          "info": "Daily/weekly never need resetting — ideal for a real dispatch or order cutoff."
        },
        {
          "type": "text",
          "id": "end_at",
          "label": "Fixed: ends at",
          "info": "Only for the fixed type. Format: 2026-12-24 23:59 (your store's time).",
          "default": ""
        },
        {
          "type": "text",
          "id": "reset_time",
          "label": "Daily/weekly: cutoff time",
          "info": "24-hour, your store's time. e.g. 14:00 for a 2pm dispatch cutoff.",
          "default": "14:00"
        },
        {
          "type": "select",
          "id": "reset_day",
          "label": "Weekly: day",
          "options": [
            {
              "value": "1",
              "label": "Monday"
            },
            {
              "value": "2",
              "label": "Tuesday"
            },
            {
              "value": "3",
              "label": "Wednesday"
            },
            {
              "value": "4",
              "label": "Thursday"
            },
            {
              "value": "5",
              "label": "Friday"
            },
            {
              "value": "6",
              "label": "Saturday"
            },
            {
              "value": "0",
              "label": "Sunday"
            }
          ],
          "default": "5"
        },
        {
          "type": "text",
          "id": "expired_text",
          "label": "Fixed: text when expired",
          "default": "This offer has ended"
        },
        {
          "type": "checkbox",
          "id": "hide_on_end",
          "label": "Fixed: hide when expired",
          "default": true
        }
      ]
    },
    {
      "type": "buy",
      "name": "Add to cart button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button text",
          "default": "Add to cart"
        },
        {
          "type": "text",
          "id": "sold_out_label",
          "label": "Sold out text",
          "default": "Sold out"
        },
        {
          "type": "checkbox",
          "id": "show_dynamic",
          "label": "Show express checkout buttons",
          "default": false
        }
      ]
    },
    {
      "type": "risk",
      "name": "Risk-removal line",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "{{GUARANTEE}}"
        }
      ]
    },
    {
      "type": "trust_points",
      "name": "Trust points",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "options": [
            {
              "value": "check-circle",
              "label": "Check"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "refresh",
              "label": "Returns"
            },
            {
              "value": "lock",
              "label": "Secure"
            }
          ],
          "default": "check-circle"
        },
        {
          "type": "textarea",
          "id": "points",
          "label": "Points (one per line)",
          "default": ""
        }
      ]
    },
    {
      "type": "spacer",
      "name": "Spacer",
      "settings": [
        {
          "type": "range",
          "id": "height",
          "label": "Height",
          "min": 8,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 16
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "ECA LP — Offer + buy",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "price"
        },
        {
          "type": "variants"
        },
        {
          "type": "inventory"
        },
        {
          "type": "buy"
        },
        {
          "type": "risk"
        }
      ]
    }
  ]
}
{% endschema %}
{% stylesheet %}
.eca-lp-offer{padding:3.5rem 1.5rem}
.eca-lp-offer__inner{display:grid;gap:2.5rem;align-items:center}
@media(min-width:750px){.eca-lp-offer__inner{grid-template-columns:1fr 1fr}}
.eca-lp-offer__media img{width:100%;height:auto;border-radius:12px;display:block}
.eca-lp-h2--left{text-align:left}
.eca-lp-offer__badge{display:inline-block;padding:.3rem .75rem;border-radius:999px;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.85rem}
.eca-lp-offer__body{line-height:1.7;opacity:.9;margin-bottom:1rem}
.eca-lp-offer__price{font-size:1.5rem;font-weight:800;margin:0 0 1rem;display:flex;align-items:baseline;gap:.5rem;flex-wrap:wrap}
.eca-lp-offer__was{opacity:.5;font-weight:400;font-size:1.1rem}
.eca-lp-offer__save{font-size:.8rem;font-weight:700;background:rgba(208,2,27,.1);color:#D0021B;padding:.2rem .55rem;border-radius:999px}
.eca-lp-offer__variants{margin:0 0 1rem}
.eca-lp-offer__vlabel{display:block;font-size:.85rem;font-weight:600;margin-bottom:.4rem}
.eca-lp-offer__vselect{width:100%;max-width:340px;padding:.7rem .9rem;border:1px solid rgba(127,127,127,.4);border-radius:10px;background:transparent;font:inherit;color:inherit}
.eca-lp-offer__inv{font-size:.9rem;margin:0 0 1rem;font-weight:600}
.eca-lp-offer__inv.is-low{color:#D0021B}
.eca-lp-offer__inv.is-in{opacity:.75;font-weight:400}
.eca-lp-offer__inv.is-out{opacity:.6}
.eca-lp-offer__inv:empty{display:none}
.eca-lp-offer__count{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin:0 0 1rem;padding:.65rem .9rem;border:1px solid rgba(127,127,127,.3);border-radius:10px;font-size:.9rem}
.eca-lp-offer__clabel{font-weight:600}
.eca-lp-offer__cvals{font-variant-numeric:tabular-nums;font-weight:800}
.eca-lp-offer__btn{border:none;cursor:pointer;font-size:1rem;width:100%;max-width:340px}
.eca-lp-offer__btn[disabled]{opacity:.5;cursor:not-allowed}
.eca-lp-offer__points{list-style:none;padding:0;margin:1rem 0 0;display:grid;gap:.45rem}
.eca-lp-offer__points li{display:flex;align-items:center;gap:.5rem;font-size:.9rem}
.eca-lp-offer__pico{width:17px;height:17px;flex:0 0 17px;opacity:.7}
.eca-lp-appslot{border:2px dashed rgba(127,127,127,.35);border-radius:12px;padding:1.5rem;text-align:center}
.eca-lp-appslot__t{font-weight:700;margin:0 0 .4rem}
.eca-lp-appslot__d{opacity:.7;margin:0;font-size:.9rem}
.eca-lp-ph{position:relative;width:100%;overflow:hidden;border-radius:12px;background:rgba(127,127,127,.08);display:flex;align-items:center;justify-content:center;min-height:200px;color:currentColor}
.eca-lp-ph--1x1{aspect-ratio:1/1}
.eca-lp-ph--4x3{aspect-ratio:4/3}
.eca-lp-ph--16x9{aspect-ratio:16/9}
.eca-lp-ph__svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.eca-lp-ph__label{position:relative;font-size:.8rem;font-weight:600;opacity:.55;padding:.4rem .8rem;background:rgba(255,255,255,.75);border-radius:999px}
{% endstylesheet %}
