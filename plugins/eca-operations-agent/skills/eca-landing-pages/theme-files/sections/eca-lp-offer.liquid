{%- comment -%}
  ECA LP — Offer + buy. Element 10. Uses the theme's NATIVE product form so it's a real add-to-cart.
{%- endcomment -%}
{%- assign product = section.settings.product -%}
<section class="eca-lp-offer">
  <div class="eca-lp-wrap eca-lp-offer__inner">
    <div class="eca-lp-offer__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title | default: section.settings.heading }}
      {%- elsif product != blank -%}
        {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
      {%- else -%}
        <div class="eca-lp-ph eca-lp-ph--1x1">{{ 'product-1' | placeholder_svg_tag: 'eca-lp-ph__svg' }}</div>
      {%- endif -%}
    </div>
    <div class="eca-lp-offer__copy">
      <h2 class="eca-lp-h2 eca-lp-h2--left">{{ section.settings.heading }}</h2>
      <div class="eca-lp-offer__body">{{ section.settings.body }}</div>
      {%- if product != blank -%}
        <p class="eca-lp-offer__price">
          {{ product.price | money }}
          {%- if product.compare_at_price > product.price -%}
            <s class="eca-lp-offer__was">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
        </p>
        {%- form 'product', product, id: 'eca-lp-offer-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="eca-lp-btn eca-lp-btn--primary" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}{{ section.settings.cta_label }}{%- else -%}Sold out{%- endif -%}
          </button>
        {%- endform -%}
      {%- else -%}
        {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: blank, style: 'primary' %}
        {%- if request.design_mode -%}<p class="eca-lp-rev__hint">Pick a product in this section's settings to enable native add-to-cart.</p>{%- endif -%}
      {%- endif -%}
      {%- if section.settings.risk_text != blank -%}<p class="eca-lp-cta__risk">{{ section.settings.risk_text }}</p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Offer + buy", "tag": "section", "class": "eca-lp-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Enables native add-to-cart." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "{{THE OFFER}}" },
    { "type": "richtext", "id": "body", "label": "Offer detail", "info": "Restate exactly what they get and any saving.", "default": "<p>{{What they get, plainly.}}</p>" },
    { "type": "image_picker", "id": "image", "label": "Image (defaults to product image)" },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Add to cart" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Only used when no product is selected." },
    { "type": "text", "id": "risk_text", "label": "Risk-removal line", "default": "{{GUARANTEE}}" }
  ],
  "presets": [{ "name": "ECA LP — Offer + buy" }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-offer{padding:3.5rem 1.5rem}
.eca-lp-offer__inner{display:grid;gap:2.5rem;align-items:center}
@media(min-width:750px){.eca-lp-offer__inner{grid-template-columns:1fr 1fr}}
.eca-lp-offer__media img{width:100%;height:auto;border-radius:12px;display:block}
.eca-lp-h2--left{text-align:left}
.eca-lp-offer__body{line-height:1.7;opacity:.9;margin-bottom:1rem}
.eca-lp-offer__price{font-size:1.5rem;font-weight:800;margin:0 0 1rem}
.eca-lp-offer__was{opacity:.5;font-weight:400;font-size:1.1rem;margin-left:.5rem}
.eca-lp-offer button.eca-lp-btn{border:none;cursor:pointer;font-size:1rem}
{% endstylesheet %}
