{%- comment -%} ECA LP — Proof. Element 5: prove the outcome is real (stats, results, demo). {%- endcomment -%}
<section class="eca-lp-proof">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.video != blank -%}
      <div class="eca-lp-proof__video">{{ section.settings.video | video_tag: image_size: '1200x', autoplay: false, loop: false, controls: true }}</div>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'eca-lp-proof__img', alt: section.settings.heading }}
    {%- elsif section.settings.show_placeholder -%}
      <div class="eca-lp-ph eca-lp-ph--16x9">{{ 'lifestyle-2' | placeholder_svg_tag: 'eca-lp-ph__svg' }}</div>
    {%- endif -%}
    <div class="eca-lp-proof__stats">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- else -%}
        <div class="eca-lp-proof__stat" {{ block.shopify_attributes }}>
          <div class="eca-lp-proof__num">{{ block.settings.stat }}</div>
          <div class="eca-lp-proof__label">{{ block.settings.label }}</div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.source != blank -%}<p class="eca-lp-proof__source">{{ section.settings.source }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Proof",
  "tag": "section", "class": "eca-lp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "{{PROOF HEADING}}" },
    { "type": "image_picker", "id": "image", "label": "Proof image (demo / before-after)" },
    { "type": "checkbox", "id": "show_placeholder", "label": "Show placeholder when no image", "default": true },
    { "type": "video", "id": "video", "label": "Proof video (overrides image)" },
    { "type": "text", "id": "source", "label": "Source / caveat line", "info": "Cite where the numbers come from. Never invent stats.", "default": "" }
  ],
  "blocks": [{
    "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "stat", "label": "Number", "default": "{{NUMBER}}" },
      { "type": "text", "id": "label", "label": "Label", "default": "{{what it measures}}" }
    ]
  }, { "type": "@app" }],
  "max_blocks": 4,
  "presets": [{ "name": "ECA LP — Proof", "blocks": [{"type":"stat"},{"type":"stat"},{"type":"stat"}] }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-proof{padding:3.5rem 1.5rem}
.eca-lp-proof__img,.eca-lp-proof__video video{width:100%;height:auto;border-radius:12px;display:block;margin:0 auto 2rem;max-width:900px}
.eca-lp-proof__stats{display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));text-align:center}
.eca-lp-proof__num{font-size:clamp(1.75rem,4vw,2.75rem);font-weight:800;line-height:1}
.eca-lp-proof__label{opacity:.75;margin-top:.35rem;font-size:.95rem}
.eca-lp-proof__source{text-align:center;font-size:.8rem;opacity:.6;margin-top:1.5rem}
{% endstylesheet %}
