{%- comment -%} eca-lp-library v1.28.0 {%- endcomment -%}
{%- comment -%}
  ECA LP — Proof. The numbers are the hero; media is supporting and optional.
{%- endcomment -%}
{%- liquid
  assign has_media = false
  if section.settings.image != blank or section.settings.video != blank
    assign has_media = true
  endif
  assign layout = section.settings.layout
  if layout != 'stats' and has_media == false and section.settings.show_placeholder == false
    assign layout = 'stats'
  endif
-%}
{%- liquid
  assign eca_cls = ''
  if section.settings.color_scheme != blank
    assign eca_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign eca_sty = ''
  if section.settings.bg_color != blank
    assign eca_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign eca_sty = eca_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}
<section class="eca-lp-proof eca-lp-proof--{{ layout }} {{ eca_cls }}" style="{{ eca_sty }}">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="eca-lp-proof__intro">{{ section.settings.intro }}</div>{%- endif -%}

    <div class="eca-lp-proof__body">
      {%- unless layout == 'stats' -%}
        <div class="eca-lp-proof__media">
          {%- if section.settings.video != blank -%}
            {{ section.settings.video | video_tag: image_size: '900x', autoplay: false, loop: false, controls: true, class: 'eca-lp-proof__vid' }}
          {%- elsif section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'eca-lp-proof__img', sizes: '(min-width: 750px) 45vw, 100vw', widths: '400,700,900', alt: section.settings.heading }}
          {%- elsif section.settings.show_placeholder -%}
            {% render 'eca-lp-placeholder', ratio: '4x3', label: 'Proof: demo, before/after or result' %}
          {%- endif -%}
        </div>
      {%- endunless -%}

      {%- if section.blocks.size > 0 -%}
        <div class="eca-lp-proof__stats eca-lp-proof__stats--{{ section.blocks.size }}">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>
            {%- else -%}
              <div class="eca-lp-proof__stat" {{ block.shopify_attributes }}>
                {%- if block.settings.icon_name != 'none' -%}
                  <span class="eca-lp-proof__ico">{% render 'eca-lp-icon', name: block.settings.icon_name %}</span>
                {%- endif -%}
                <div class="eca-lp-proof__num">{{ block.settings.stat }}</div>
                <div class="eca-lp-proof__label">{{ block.settings.label }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.source != blank -%}<p class="eca-lp-proof__source">{{ section.settings.source }}</p>{%- endif -%}
    {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: section.settings.risk_text, style: 'primary' %}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Proof",
  "tag": "section",
  "class": "eca-lp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "{{PROOF HEADING}}"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro (optional)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "stats",
          "label": "Stats only (no image)"
        },
        {
          "value": "split",
          "label": "Image left, stats right"
        },
        {
          "value": "split-right",
          "label": "Image right, stats left"
        },
        {
          "value": "stacked",
          "label": "Image above stats"
        }
      ],
      "default": "split",
      "info": "Stats-only is often strongest — the numbers are the proof."
    },
    {
      "type": "header",
      "content": "Media (optional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Proof image (demo / before-after)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Proof video (overrides image)"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholder when no image",
      "default": true
    },
    {
      "type": "header",
      "content": "Footnote & CTA"
    },
    {
      "type": "text",
      "id": "source",
      "label": "Source / caveat line",
      "info": "Cite where the numbers come from. Never invent stats.",
      "default": ""
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text",
      "default": ""
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "risk_text",
      "label": "Risk-removal line",
      "default": ""
    },
    {
      "type": "header",
      "content": "Section colour"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Uses your theme's colour schemes so text and buttons stay readable. Leave as-is to inherit the page."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)",
      "info": "Overrides the scheme. Only use if you need an exact colour."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text (optional)"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "No icon"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "dollar",
              "label": "Dollar"
            },
            {
              "value": "bolt",
              "label": "Bolt"
            },
            {
              "value": "check-circle",
              "label": "Check"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "package",
              "label": "Package"
            }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "stat",
          "label": "Number",
          "default": "{{NUMBER}}"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "{{what it measures}}"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "ECA LP — Proof",
      "blocks": [
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        }
      ]
    }
  ]
}
{% endschema %}
{% stylesheet %}
.eca-lp-proof{padding:3.5rem 1.5rem}
.eca-lp-proof__intro{text-align:center;max-width:620px;margin:0 auto 2rem;opacity:.85;line-height:1.7}
.eca-lp-proof__body{display:grid;gap:2rem;align-items:center;margin-top:1.5rem}
@media(min-width:750px){
  .eca-lp-proof--split .eca-lp-proof__body,
  .eca-lp-proof--split-right .eca-lp-proof__body{grid-template-columns:1fr 1fr}
  .eca-lp-proof--split-right .eca-lp-proof__media{order:2}
}
.eca-lp-proof__img,.eca-lp-proof__vid{width:100%;height:auto;border-radius:14px;display:block}
.eca-lp-proof__stats{display:grid;gap:1rem}
.eca-lp-proof--stats .eca-lp-proof__stats,
.eca-lp-proof--stacked .eca-lp-proof__stats{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));max-width:900px;margin:0 auto}
@media(min-width:750px){.eca-lp-proof--split .eca-lp-proof__stats,.eca-lp-proof--split-right .eca-lp-proof__stats{grid-template-columns:1fr}}
.eca-lp-proof__stat{background:rgba(255,255,255,.6);border:1px solid rgba(127,127,127,.18);border-radius:14px;padding:1.4rem 1.25rem;text-align:center}
@media(min-width:750px){
  .eca-lp-proof--split .eca-lp-proof__stat,.eca-lp-proof--split-right .eca-lp-proof__stat{text-align:left;display:grid;grid-template-columns:auto 1fr;gap:0 1rem;align-items:center;padding:1.15rem 1.35rem}
  .eca-lp-proof--split .eca-lp-proof__ico,.eca-lp-proof--split-right .eca-lp-proof__ico{grid-row:span 2;margin:0}
}
.eca-lp-proof__ico{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:rgba(127,127,127,.12);margin:0 auto .6rem}
.eca-lp-proof__ico svg{width:19px;height:19px}
.eca-lp-proof__num{font-size:clamp(1.6rem,3.2vw,2.4rem);font-weight:800;line-height:1.05;letter-spacing:-.02em}
.eca-lp-proof__label{opacity:.7;margin-top:.3rem;font-size:.9rem;line-height:1.45}
.eca-lp-proof__source{text-align:center;font-size:.78rem;opacity:.55;margin-top:1.5rem}
.eca-lp-proof .eca-lp-cta{text-align:center;margin-top:1.75rem}
.eca-lp-ph{position:relative;width:100%;overflow:hidden;border-radius:14px;background:rgba(127,127,127,.08);display:flex;align-items:center;justify-content:center;min-height:180px;color:currentColor}
.eca-lp-ph--4x3{aspect-ratio:4/3}
.eca-lp-ph--16x9{aspect-ratio:16/9}
.eca-lp-ph--1x1{aspect-ratio:1/1}
.eca-lp-ph__svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.eca-lp-ph__label{position:relative;font-size:.78rem;font-weight:600;opacity:.55;padding:.35rem .75rem;background:rgba(255,255,255,.75);border-radius:999px;text-align:center}
{% endstylesheet %}
