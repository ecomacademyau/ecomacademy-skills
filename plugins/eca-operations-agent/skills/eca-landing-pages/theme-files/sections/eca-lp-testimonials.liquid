{%- comment -%} ECA LP — Testimonials. Element 8: real customer quotes, each answering a different objection. {%- endcomment -%}
<section class="eca-lp-tst">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.use_app_widget -%}
      {%- comment -%} App handles this section — don't duplicate it with custom quotes {%- endcomment -%}
      {%- assign has_app = false -%}
      {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{%- assign has_app = true -%}{%- endif -%}{%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}<div {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}
      {%- endfor -%}
      {%- unless has_app -%}
        {%- if request.design_mode -%}
          <div class="eca-lp-appslot">
            <p class="eca-lp-appslot__t">Add your review app's block here</p>
            <p class="eca-lp-appslot__d">Click <strong>Add block</strong> and choose your reviews app (Judge.me, Loox, Okendo, Yotpo, Stamped). Using the app's own widget keeps the star ratings and review counts live and accurate.</p>
          </div>
        {%- endif -%}
      {%- endunless -%}
    {%- else -%}
    <div class="eca-lp-tst__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="eca-lp-tst__app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- else -%}
        <figure class="eca-lp-tst__card" {{ block.shopify_attributes }}>
          {%- if block.settings.show_stars -%}
            <div class="eca-lp-tst__stars"{% if section.settings.star_color != blank %} style="color:{{ section.settings.star_color }}"{% endif %} aria-label="{{ block.settings.star_count }} out of 5 stars">
              {%- assign w = block.settings.star_count | floor -%}
              {%- for i in (1..w) -%}{% render 'eca-lp-icon', name: 'star-filled', class: 'eca-lp-star' %}{%- endfor -%}
              {%- assign r = block.settings.star_count | minus: w -%}
              {%- if r >= 0.25 -%}{% render 'eca-lp-icon', name: 'star-half', class: 'eca-lp-star' %}{%- endif -%}
            </div>
          {%- endif -%}
          <blockquote class="eca-lp-tst__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="eca-lp-tst__by">
            {%- if block.settings.photo != blank -%}
              {{ block.settings.photo | image_url: width: 96 | image_tag: loading: 'lazy', class: 'eca-lp-tst__photo', alt: block.settings.name }}
            {%- endif -%}
            <span>{{ block.settings.name }}{% if block.settings.context != blank %} <em>{{ block.settings.context }}</em>{% endif %}</span>
          </figcaption>
        </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
    {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: section.settings.risk_text, style: 'primary' %}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Testimonials", "tag": "section", "class": "eca-lp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "color", "id": "star_color", "label": "Star colour", "info": "Applies to all testimonial stars in this section.", "default": "#F5A623" },
    { "type": "checkbox", "id": "use_app_widget", "label": "Use my review app's widget (recommended)", "info": "ON by default. Shows your review app's live reviews instead of manually written quotes — click Add block and pick your app (Judge.me, Loox, Okendo, Yotpo, Stamped). Untick only if you have no reviews app and want to enter quotes by hand.", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "risk_text", "label": "Risk-removal line", "default": "" }
  ],
  "blocks": [{
    "type": "quote", "name": "Testimonial", "settings": [
      { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": true },
      { "type": "range", "id": "star_count", "label": "Rating", "min": 0, "max": 5, "step": 0.5, "unit": "\u2605", "default": 5 },
      { "type": "richtext", "id": "quote", "label": "Quote", "info": "Use real customer words only. Never invent a review.", "default": "<p>{{REAL CUSTOMER QUOTE}}</p>" },
      { "type": "text", "id": "name", "label": "Name", "default": "{{Name}}" },
      { "type": "text", "id": "context", "label": "Context (optional)", "info": "e.g. Verified buyer" },
      { "type": "image_picker", "id": "photo", "label": "Photo (optional)" }
    ]
  }, { "type": "@app" }],
  "max_blocks": 8,
  "presets": [{ "name": "ECA LP — Testimonials", "blocks": [{"type":"quote"},{"type":"quote"},{"type":"quote"}] }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-tst{padding:3.5rem 1.5rem;background:rgba(0,0,0,.02)}
.eca-lp-tst__grid{display:grid;gap:1.5rem;margin-top:2rem}
@media(min-width:750px){.eca-lp-tst__grid{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}}
.eca-lp-tst__card{background:#fff;border-radius:12px;padding:1.5rem;margin:0;box-shadow:0 1px 3px rgba(0,0,0,.08)}
.eca-lp-tst__stars{display:inline-flex;align-items:center;gap:1px;margin-bottom:.65rem}
.eca-lp-tst__stars .eca-lp-star{width:16px;height:16px;flex:0 0 16px}
.eca-lp-tst__quote{margin:0 0 1rem;line-height:1.6;font-size:1.02rem}
.eca-lp-tst__by{display:flex;align-items:center;gap:.6rem;font-size:.9rem;font-weight:600}
.eca-lp-tst__by em{font-weight:400;opacity:.65;font-style:normal}
.eca-lp-tst__photo{width:36px;height:36px;border-radius:999px;object-fit:cover}
.eca-lp-tst .eca-lp-cta{text-align:center;margin-top:2.5rem}
.eca-lp-appslot{border:2px dashed rgba(0,0,0,.2);border-radius:12px;padding:2rem;text-align:center;margin-top:1.5rem}
.eca-lp-appslot__t{font-weight:700;margin:0 0 .5rem}
.eca-lp-appslot__d{opacity:.7;margin:0;font-size:.9rem;max-width:460px;margin-inline:auto;line-height:1.6}
{% endstylesheet %}
