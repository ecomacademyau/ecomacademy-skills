{%- comment -%} ECA LP — Testimonials. Element 8: real customer quotes, each answering a different objection. {%- endcomment -%}
<section class="eca-lp-tst">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="eca-lp-tst__grid">
      {%- for block in section.blocks -%}
        <figure class="eca-lp-tst__card" {{ block.shopify_attributes }}>
          {%- if block.settings.stars != blank -%}<div class="eca-lp-tst__stars">{{ block.settings.stars }}</div>{%- endif -%}
          <blockquote class="eca-lp-tst__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="eca-lp-tst__by">
            {%- if block.settings.photo != blank -%}
              {{ block.settings.photo | image_url: width: 96 | image_tag: loading: 'lazy', class: 'eca-lp-tst__photo', alt: block.settings.name }}
            {%- endif -%}
            <span>{{ block.settings.name }}{% if block.settings.context != blank %} <em>{{ block.settings.context }}</em>{% endif %}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
    {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: section.settings.risk_text, style: 'primary' %}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Testimonials", "tag": "section", "class": "eca-lp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "risk_text", "label": "Risk-removal line", "default": "" }
  ],
  "blocks": [{
    "type": "quote", "name": "Testimonial", "settings": [
      { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
      { "type": "richtext", "id": "quote", "label": "Quote", "info": "Use real customer words only. Never invent a review.", "default": "<p>{{REAL CUSTOMER QUOTE}}</p>" },
      { "type": "text", "id": "name", "label": "Name", "default": "{{Name}}" },
      { "type": "text", "id": "context", "label": "Context (optional)", "info": "e.g. Verified buyer" },
      { "type": "image_picker", "id": "photo", "label": "Photo (optional)" }
    ]
  }],
  "max_blocks": 8,
  "presets": [{ "name": "ECA LP — Testimonials", "blocks": [{"type":"quote"},{"type":"quote"},{"type":"quote"}] }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-tst{padding:3.5rem 1.5rem;background:rgba(0,0,0,.02)}
.eca-lp-tst__grid{display:grid;gap:1.5rem;margin-top:2rem}
@media(min-width:750px){.eca-lp-tst__grid{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}}
.eca-lp-tst__card{background:#fff;border-radius:12px;padding:1.5rem;margin:0;box-shadow:0 1px 3px rgba(0,0,0,.08)}
.eca-lp-tst__stars{letter-spacing:.1em;margin-bottom:.65rem}
.eca-lp-tst__quote{margin:0 0 1rem;line-height:1.6;font-size:1.02rem}
.eca-lp-tst__by{display:flex;align-items:center;gap:.6rem;font-size:.9rem;font-weight:600}
.eca-lp-tst__by em{font-weight:400;opacity:.65;font-style:normal}
.eca-lp-tst__photo{width:36px;height:36px;border-radius:999px;object-fit:cover}
.eca-lp-tst .eca-lp-cta{text-align:center;margin-top:2.5rem}
{% endstylesheet %}
