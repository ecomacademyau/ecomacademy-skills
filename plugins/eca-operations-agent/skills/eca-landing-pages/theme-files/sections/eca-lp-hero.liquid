{%- comment -%} ECA LP — Hero. Element 1-3: hook, matching image, CTA + risk removal. {%- endcomment -%}
<section class="eca-lp-hero eca-lp-hero--{{ section.settings.layout }}" style="--eca-lp-pad:{{ section.settings.padding }}px">
  <div class="eca-lp-hero__inner">
    <div class="eca-lp-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eca-lp-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="eca-lp-hero__headline">{{ section.settings.headline }}</h1>
      {%- if section.settings.subhead != blank -%}
        <div class="eca-lp-hero__subhead">{{ section.settings.subhead }}</div>
      {%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <p class="eca-lp-hero__rating">{{ section.settings.rating_text }}</p>
      {%- endif -%}
      {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: section.settings.risk_text, style: 'primary' %}
    </div>
    <div class="eca-lp-hero__media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1200x', autoplay: true, loop: true, muted: true, controls: true }}
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600,900,1200,1800', alt: section.settings.image_alt }}
      {%- else -%}
        {%- comment -%} Placeholder until the member adds their own image {%- endcomment -%}
        <div class="eca-lp-ph eca-lp-ph--16x9">{{ 'lifestyle-1' | placeholder_svg_tag: 'eca-lp-ph__svg' }}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Hero",
  "tag": "section",
  "class": "eca-lp-section",
  "settings": [
    { "type": "header", "content": "Hook (match your ad's promise)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (leave blank — off by default)", "info": "Usually leave empty. An eyebrow pushes your headline down and competes with it, and the offer converts better at the CTA. Only use it for something genuinely useful above the hook, e.g. a trust line like 'As seen in...'. Never the page type or a discount.", "default": "" },
    { "type": "text", "id": "headline", "label": "Headline", "info": "Echo your ad's strongest line so the visitor knows they're in the right place.", "default": "{{HEADLINE — match your ad's promise}}" },
    { "type": "richtext", "id": "subhead", "label": "Sub-headline", "info": "One line that expands the promise or handles the first objection.", "default": "<p>{{SUBHEAD — expand the promise in one line}}</p>" },
    { "type": "text", "id": "rating_text", "label": "Rating / social proof line", "info": "e.g. Rated 4.9/5 from 263 reviews. Leave blank to hide.", "default": "" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "risk_text", "label": "Risk-removal line", "info": "Sits under the button, e.g. 30-day money-back guarantee.", "default": "{{GUARANTEE — e.g. 30-day money-back guarantee}}" },
    { "type": "header", "content": "Media (match the ad's creative)" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Ideally a frame from the ad creative itself." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "" },
    { "type": "video", "id": "video", "label": "Video (overrides image)" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "split", "label": "Split (copy + media)" },
      { "value": "centered", "label": "Centered (media below)" },
      { "value": "editorial", "label": "Editorial (advertorial style)" }
    ], "default": "split" },
    { "type": "range", "id": "padding", "label": "Section padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "ECA LP — Hero" }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-hero{padding:var(--eca-lp-pad,56px) 1.5rem}
.eca-lp-hero__inner{max-width:1200px;margin:0 auto;display:grid;gap:2.5rem;align-items:center}
.eca-lp-hero--split .eca-lp-hero__inner{grid-template-columns:1fr}
@media(min-width:750px){.eca-lp-hero--split .eca-lp-hero__inner{grid-template-columns:1fr 1fr}}
.eca-lp-hero--centered .eca-lp-hero__inner,.eca-lp-hero--editorial .eca-lp-hero__inner{max-width:760px;text-align:center}
.eca-lp-hero--editorial .eca-lp-hero__inner{text-align:left}
.eca-lp-hero__eyebrow{text-transform:uppercase;letter-spacing:.1em;font-size:.75rem;font-weight:700;opacity:.7;margin:0 0 .75rem}
.eca-lp-hero__headline{font-size:clamp(1.9rem,4.5vw,3.2rem);line-height:1.1;margin:0 0 1rem}
.eca-lp-hero__subhead{font-size:1.125rem;line-height:1.6;opacity:.85;margin-bottom:1.25rem}
.eca-lp-hero__rating{font-size:.95rem;font-weight:600;margin:0 0 1.25rem}
.eca-lp-hero__media img,.eca-lp-hero__media video{width:100%;height:auto;border-radius:12px;display:block}
.eca-lp-cta{margin-top:1.25rem}
.eca-lp-btn{display:inline-block;padding:.9rem 2rem;border-radius:999px;font-weight:700;text-decoration:none;background:currentColor;transition:opacity .2s}
.eca-lp-btn:hover{opacity:.85}
.eca-lp-btn--primary{background:rgb(var(--color-button,17,17,17));color:rgb(var(--color-button-text,255,255,255))}
.eca-lp-btn--secondary{background:transparent;border:2px solid currentColor}
.eca-lp-cta__risk{font-size:.875rem;opacity:.75;margin:.65rem 0 0}
.eca-lp-ph{position:relative;width:100%;overflow:hidden;border-radius:12px;background:rgba(0,0,0,.04);display:block;min-height:180px}
.eca-lp-ph--16x9{aspect-ratio:16/9}
.eca-lp-ph--4x3{aspect-ratio:4/3}
.eca-lp-ph--1x1{aspect-ratio:1/1}
.eca-lp-ph__svg{width:100%;height:100%;display:block;fill:rgba(0,0,0,.12);object-fit:cover}
{% endstylesheet %}
