{%- comment -%} eca-lp-library v1.29.0 {%- endcomment -%}
{%- comment -%} ECA LP — Advertorial article body. Long-form story with inline images and soft CTAs. {%- endcomment -%}
{%- liquid
  assign eca_cls = ''
  if section.settings.color_scheme != blank
    assign eca_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign eca_sty = ''
  if section.settings.bg_color != blank
    assign eca_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign eca_sty = eca_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}
<section class="eca-lp-art {{ eca_cls }}" style="{{ eca_sty }}">
  <div class="eca-lp-wrap eca-lp-wrap--narrow">
    {%- if section.settings.disclosure != blank -%}
      <p class="eca-lp-art__disclosure">{{ section.settings.disclosure }}</p>
    {%- endif -%}
    {%- if section.settings.byline != blank -%}<p class="eca-lp-art__byline">{{ section.settings.byline }}</p>{%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'paragraph' -%}
          <div class="eca-lp-art__body" {{ block.shopify_attributes }}>{{ block.settings.body }}</div>
        {%- when 'subhead' -%}
          <h2 class="eca-lp-art__subhead" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'image' -%}
          <figure class="eca-lp-art__figure" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.caption }}
            {%- else -%}
              {% render 'eca-lp-placeholder', ratio: '16x9', label: 'Article image' %}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- when 'pullquote' -%}
          <blockquote class="eca-lp-art__pull" {{ block.shopify_attributes }}>{{ block.settings.text }}</blockquote>
        {%- when 'cta' -%}
          <div {{ block.shopify_attributes }}>{% render 'eca-lp-cta', label: block.settings.label, url: block.settings.url, risk: block.settings.risk, style: 'primary' %}</div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Article body",
  "tag": "section",
  "class": "eca-lp-section",
  "settings": [
    {
      "type": "text",
      "id": "disclosure",
      "label": "Advertising disclosure",
      "info": "Required on advertorials. Keep it to the disclosure only (e.g. 'Advertisement' or 'Sponsored') — never append the internal page/format name.",
      "default": "Advertisement"
    },
    {
      "type": "text",
      "id": "byline",
      "label": "Byline / dateline",
      "info": "Editorial credit only, e.g. 'By Jane Doe' or a city and date. Not the page type.",
      "default": ""
    },
    {
      "type": "header",
      "content": "Section colour"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Uses your theme's colour schemes so text and buttons stay readable. Leave as-is to inherit the page."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)",
      "info": "Overrides the scheme. Only use if you need an exact colour."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text (optional)"
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "body",
          "label": "Text",
          "default": "<p>{{Story paragraph — first person, true, specific.}}</p>"
        }
      ]
    },
    {
      "type": "subhead",
      "name": "Subheading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Subheading",
          "default": "{{SUBHEAD}}"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    },
    {
      "type": "pullquote",
      "name": "Pull quote",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Quote",
          "default": "{{PULL QUOTE}}"
        }
      ]
    },
    {
      "type": "cta",
      "name": "Inline CTA",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "risk",
          "label": "Risk-removal line",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "ECA LP — Advertorial body",
      "blocks": [
        {
          "type": "paragraph"
        },
        {
          "type": "subhead"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "cta"
        }
      ]
    }
  ]
}
{% endschema %}
{% stylesheet %}
.eca-lp-art{padding:2.5rem 1.5rem 3.5rem}
.eca-lp-art__disclosure{text-transform:uppercase;letter-spacing:.12em;font-size:.7rem;opacity:.55;border-bottom:1px solid rgba(0,0,0,.1);padding-bottom:.75rem;margin:0 0 1.25rem}
.eca-lp-art__byline{font-size:.9rem;opacity:.65;margin:0 0 1.75rem}
.eca-lp-art__body{line-height:1.8;font-size:1.06rem;margin-bottom:1.25rem}
.eca-lp-art__subhead{font-size:1.4rem;line-height:1.3;margin:2rem 0 .85rem}
.eca-lp-art__figure{margin:1.75rem 0}
.eca-lp-art__figure img{width:100%;height:auto;border-radius:10px;display:block}
.eca-lp-art__figure figcaption{font-size:.85rem;opacity:.6;margin-top:.5rem}
.eca-lp-art__pull{border-left:4px solid currentColor;margin:1.75rem 0;padding:.25rem 0 .25rem 1.25rem;font-size:1.2rem;line-height:1.5;font-weight:600}
.eca-lp-art .eca-lp-cta{text-align:center;margin:2rem 0}
.eca-lp-ph{position:relative;width:100%;overflow:hidden;border-radius:12px;background:rgba(127,127,127,.08);display:flex;align-items:center;justify-content:center;min-height:200px;color:currentColor}
.eca-lp-ph--16x9{aspect-ratio:16/9}
.eca-lp-ph--4x3{aspect-ratio:4/3}
.eca-lp-ph--1x1{aspect-ratio:1/1}
.eca-lp-ph__svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.eca-lp-ph__label{position:relative;font-size:.8rem;font-weight:600;opacity:.55;text-align:center;padding:.4rem .8rem;background:rgba(255,255,255,.75);border-radius:999px}
{% endstylesheet %}
