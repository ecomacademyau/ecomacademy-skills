{%- comment -%}
  ECA LP — Listicle. Article-first: convinces through the list, THEN introduces the product.
  No CTA before the list has done its work.
{%- endcomment -%}
<section class="eca-lp-listicle">
  <div class="eca-lp-wrap eca-lp-wrap--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="eca-lp-listicle__intro">{{ section.settings.intro }}</div>{%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div {{ block.shopify_attributes }}>{% render block %}</div>
      {%- else -%}
        {%- liquid
          assign pos = section.settings.image_position
          if pos == 'alternate'
            assign pos = 'left'
            assign mod = forloop.index0 | modulo: 2
            if mod == 1
              assign pos = 'right'
            endif
          endif
        -%}
        <article class="eca-lp-li eca-lp-li--{{ pos }}" {{ block.shopify_attributes }}>
          {%- unless pos == 'none' -%}
            <div class="eca-lp-li__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'eca-lp-li__img', sizes: '(min-width: 750px) 40vw, 100vw', widths: '400,700,1000', alt: block.settings.image_alt }}
              {%- else -%}
                {% render 'eca-lp-placeholder', ratio: '4x3', label: 'Add an image' %}
              {%- endif -%}
            </div>
          {%- endunless -%}
          <div class="eca-lp-li__body">
            <div class="eca-lp-li__num">{{ forloop.index }}</div>
            <h3 class="eca-lp-li__title">{{ block.settings.title }}</h3>
            <div class="eca-lp-li__text">{{ block.settings.body }}</div>
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} The close: the list has done the convincing, now the ask. {%- endcomment -%}
    {%- if section.settings.close_heading != blank or section.settings.close_body != blank -%}
      <div class="eca-lp-listicle__close">
        {%- if section.settings.close_heading != blank -%}<h3 class="eca-lp-listicle__close-h">{{ section.settings.close_heading }}</h3>{%- endif -%}
        {%- if section.settings.close_body != blank -%}<div class="eca-lp-listicle__close-b">{{ section.settings.close_body }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: section.settings.risk_text, style: 'primary' %}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Listicle",
  "tag": "section", "class": "eca-lp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "{{N reasons ...}}" },
    { "type": "richtext", "id": "intro", "label": "Intro (optional)", "info": "One or two lines that set up the list. Keep it editorial — no selling yet." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
      { "value": "left", "label": "Image left, text right" },
      { "value": "right", "label": "Image right, text left" },
      { "value": "alternate", "label": "Alternate left / right" },
      { "value": "none", "label": "No images (text only)" }
    ], "default": "left", "info": "Images are placeholders until you add your own." },
    { "type": "header", "content": "The close (after the list)" },
    { "type": "text", "id": "close_heading", "label": "Closing heading", "info": "Introduce the product here — after the list has convinced." },
    { "type": "richtext", "id": "close_body", "label": "Closing copy" },
    { "type": "text", "id": "cta_label", "label": "Button text", "info": "Make it follow on from the list, e.g. 'Ditch the machine — try it' rather than 'Shop now'." },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "risk_text", "label": "Risk-removal line" }
  ],
  "blocks": [{
    "type": "item", "name": "List item", "settings": [
      { "type": "text", "id": "title", "label": "Item headline", "default": "{{REASON}}" },
      { "type": "richtext", "id": "body", "label": "Body (2 paragraphs)", "info": "Write 1-2 full paragraphs, not a single line. Para 1: the problem or insight this reason names, in the reader's world. Para 2: how it actually plays out differently. Each item should stand alone as a short piece of writing.", "default": "<p>{{Paragraph 1 — name the problem or insight, in the reader's world.}}</p><p>{{Paragraph 2 — how it plays out differently, concretely.}}</p>" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_alt", "label": "Image alt text" }
    ]
  }, { "type": "@app" }],
  "max_blocks": 12,
  "presets": [{ "name": "ECA LP — Listicle", "blocks": [{"type":"item"},{"type":"item"},{"type":"item"}] }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-listicle{padding:3.5rem 1.5rem}
.eca-lp-wrap--narrow{max-width:860px}
.eca-lp-listicle__intro{text-align:center;max-width:620px;margin:0 auto 2.5rem;opacity:.85;line-height:1.7}
.eca-lp-li{display:grid;gap:1.5rem;padding:2rem 0;border-bottom:1px solid rgba(0,0,0,.08);align-items:center}
.eca-lp-li:last-of-type{border-bottom:none}
@media(min-width:750px){
  .eca-lp-li--left{grid-template-columns:0.8fr 1fr}
  .eca-lp-li--right{grid-template-columns:1fr 0.8fr}
  .eca-lp-li--right .eca-lp-li__media{order:2}
}
.eca-lp-li__img{width:100%;height:auto;border-radius:12px;display:block}
.eca-lp-li__num{display:inline-grid;place-items:center;width:2rem;height:2rem;border-radius:999px;font-weight:800;font-size:.9rem;background:rgba(0,0,0,.07);margin-bottom:.65rem}
.eca-lp-li__title{margin:0 0 .6rem;font-size:1.3rem;line-height:1.3}
.eca-lp-li__text{line-height:1.7;opacity:.9}
.eca-lp-listicle__close{margin-top:2.5rem;text-align:center}
.eca-lp-listicle__close-h{font-size:1.5rem;margin:0 0 .75rem}
.eca-lp-listicle__close-b{line-height:1.7;opacity:.9;max-width:620px;margin:0 auto}
.eca-lp-listicle .eca-lp-cta{text-align:center;margin-top:1.75rem}
.eca-lp-ph{position:relative;width:100%;overflow:hidden;border-radius:12px;background:rgba(127,127,127,.08);display:flex;align-items:center;justify-content:center;min-height:200px;color:currentColor}
.eca-lp-ph--16x9{aspect-ratio:16/9}
.eca-lp-ph--4x3{aspect-ratio:4/3}
.eca-lp-ph--1x1{aspect-ratio:1/1}
.eca-lp-ph__svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.eca-lp-ph__label{position:relative;font-size:.8rem;font-weight:600;opacity:.55;text-align:center;padding:.4rem .8rem;background:rgba(255,255,255,.75);border-radius:999px}
{% endstylesheet %}
