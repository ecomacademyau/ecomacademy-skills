{%- comment -%} eca-lp-library v1.18.0 {%- endcomment -%}
{%- comment -%} ECA LP — Benefits. Element 4: benefit / outcome / transformation. {%- endcomment -%}
<section class="eca-lp-benefits">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="eca-lp-intro">{{ section.settings.intro }}</div>{%- endif -%}
    <div class="eca-lp-benefits__grid eca-lp-benefits__grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- else -%}
        <div class="eca-lp-benefits__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', class: 'eca-lp-benefits__icon', alt: '' }}
          {%- elsif block.settings.icon_name != 'none' -%}
            <span class="eca-lp-benefits__ico">{% render 'eca-lp-icon', name: block.settings.icon_name %}</span>
          {%- endif -%}
          <h3 class="eca-lp-benefits__title">{{ block.settings.title }}</h3>
          <div class="eca-lp-benefits__body">{{ block.settings.body }}</div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: section.settings.risk_text, style: 'primary' %}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Benefits",
  "tag": "section", "class": "eca-lp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "{{HEADING — the transformation}}" },
    { "type": "richtext", "id": "intro", "label": "Intro (optional)" },
    { "type": "select", "id": "columns", "label": "Columns", "options": [{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}], "default": "3" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "risk_text", "label": "Risk-removal line", "default": "" }
  ],
  "blocks": [{
    "type": "benefit", "name": "Benefit", "settings": [
      { "type": "select", "id": "icon_name", "label": "Icon", "info": "Built-in icons inherit your theme colour. Choose one per benefit to break up the text.", "options": [
        {"value":"none","label":"No icon"},{"value":"check","label":"Check"},{"value":"check-circle","label":"Check in circle"},
        {"value":"star","label":"Star"},{"value":"clock","label":"Clock / time"},{"value":"bolt","label":"Bolt / fast"},
        {"value":"shield","label":"Shield / guarantee"},{"value":"truck","label":"Truck / shipping"},{"value":"leaf","label":"Leaf / eco"},
        {"value":"heart","label":"Heart"},{"value":"sparkle","label":"Sparkle / quality"},{"value":"dollar","label":"Dollar / value"},
        {"value":"refresh","label":"Refresh / subscription"},{"value":"lock","label":"Lock / secure"},{"value":"package","label":"Package"},
        {"value":"smile","label":"Smile"},{"value":"award","label":"Award"}
      ], "default": "check" },
      { "type": "image_picker", "id": "icon", "label": "Custom icon image (overrides the icon above)" },
      { "type": "text", "id": "title", "label": "Outcome", "info": "Lead with the outcome, not the feature.", "default": "{{OUTCOME}}" },
      { "type": "richtext", "id": "body", "label": "Supporting detail", "default": "<p>{{The feature that makes it true}}</p>" }
    ]
  }, { "type": "@app" }],
  "max_blocks": 6,
  "presets": [{ "name": "ECA LP — Benefits", "blocks": [{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}] }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-benefits{padding:3.5rem 1.5rem}
.eca-lp-wrap{max-width:1100px;margin:0 auto}
.eca-lp-h2{font-size:clamp(1.5rem,3vw,2.25rem);line-height:1.2;margin:0 0 1rem;text-align:center}
.eca-lp-intro{text-align:center;max-width:640px;margin:0 auto 2.5rem;opacity:.85}
.eca-lp-benefits__grid{display:grid;gap:2rem}
@media(min-width:750px){.eca-lp-benefits__grid--2{grid-template-columns:repeat(2,1fr)}.eca-lp-benefits__grid--3{grid-template-columns:repeat(3,1fr)}.eca-lp-benefits__grid--4{grid-template-columns:repeat(4,1fr)}}
.eca-lp-benefits__icon{width:48px;height:48px;object-fit:contain;margin-bottom:.75rem}
.eca-lp-benefits__ico{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:rgba(127,127,127,.1);margin-bottom:.85rem}
.eca-lp-benefits__ico svg{width:22px;height:22px}
.eca-lp-benefits__title{font-size:1.15rem;margin:0 0 .5rem}
.eca-lp-benefits__body{opacity:.85;line-height:1.6}
.eca-lp-benefits .eca-lp-cta{text-align:center;margin-top:2.5rem}
{% endstylesheet %}
