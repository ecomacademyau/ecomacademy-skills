{%- comment -%} eca-lp-library v1.28.0 {%- endcomment -%}
{%- comment -%} ECA LP — Benefits. Element 4: benefit / outcome / transformation. {%- endcomment -%}
{%- liquid
  assign eca_cls = ''
  if section.settings.color_scheme != blank
    assign eca_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign eca_sty = ''
  if section.settings.bg_color != blank
    assign eca_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign eca_sty = eca_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}
<section class="eca-lp-benefits {{ eca_cls }}" style="{{ eca_sty }}">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="eca-lp-intro">{{ section.settings.intro }}</div>{%- endif -%}
    <div class="eca-lp-benefits__grid eca-lp-benefits__grid--{{ section.settings.columns }} eca-lp-benefits__grid--m{{ section.settings.media_position }} eca-lp-benefits__grid--a{{ section.settings.item_align }}" style="--eca-ben-size:{{ section.settings.media_size }}px;--eca-ben-fit:{{ section.settings.media_fit }};--eca-ben-radius:{{ section.settings.media_radius }}px;">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- else -%}
        <div class="eca-lp-benefits__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="eca-lp-benefits__media">
              {{ block.settings.icon | image_url: width: 600 | image_tag: loading: 'lazy', class: 'eca-lp-benefits__icon', widths: '100,200,400,600', alt: block.settings.title }}
            </div>
          {%- elsif block.settings.icon_name != 'none' -%}
            <div class="eca-lp-benefits__media">
              <span class="eca-lp-benefits__ico">{% render 'eca-lp-icon', name: block.settings.icon_name %}</span>
            </div>
          {%- endif -%}
          <div class="eca-lp-benefits__txt">
            <h3 class="eca-lp-benefits__title">{{ block.settings.title }}</h3>
            <div class="eca-lp-benefits__body">{{ block.settings.body }}</div>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {% render 'eca-lp-cta', label: section.settings.cta_label, url: section.settings.cta_url, risk: section.settings.risk_text, style: 'primary' %}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Benefits",
  "tag": "section",
  "class": "eca-lp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "{{HEADING — the transformation}}"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro (optional)"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Icons & images"
    },
    {
      "type": "paragraph",
      "content": "Applies to every item, so they stay consistent. Small icons suit a 3-4 column grid; larger photos suit 2 columns."
    },
    {
      "type": "range",
      "id": "media_size",
      "label": "Size",
      "min": 24,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Position",
      "options": [
        {
          "value": "top",
          "label": "Above the text"
        },
        {
          "value": "left",
          "label": "Beside the text"
        }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "If the image isn't square",
      "options": [
        {
          "value": "contain",
          "label": "Show the whole image"
        },
        {
          "value": "cover",
          "label": "Fill the space (crops)"
        }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Corner rounding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Set this to half the size for a circle."
    },
    {
      "type": "select",
      "id": "item_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text",
      "default": ""
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "risk_text",
      "label": "Risk-removal line",
      "default": ""
    },
    {
      "type": "header",
      "content": "Section colour"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Uses your theme's colour schemes so text and buttons stay readable. Leave as-is to inherit the page."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)",
      "info": "Overrides the scheme. Only use if you need an exact colour."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text (optional)"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icon",
          "info": "Built-in icons inherit your theme colour. Choose one per benefit to break up the text.",
          "options": [
            {
              "value": "none",
              "label": "No icon"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "check-circle",
              "label": "Check in circle"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "clock",
              "label": "Clock / time"
            },
            {
              "value": "bolt",
              "label": "Bolt / fast"
            },
            {
              "value": "shield",
              "label": "Shield / guarantee"
            },
            {
              "value": "truck",
              "label": "Truck / shipping"
            },
            {
              "value": "leaf",
              "label": "Leaf / eco"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "sparkle",
              "label": "Sparkle / quality"
            },
            {
              "value": "dollar",
              "label": "Dollar / value"
            },
            {
              "value": "refresh",
              "label": "Refresh / subscription"
            },
            {
              "value": "lock",
              "label": "Lock / secure"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "smile",
              "label": "Smile"
            },
            {
              "value": "award",
              "label": "Award"
            }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Image (used instead of the icon)",
          "info": "Size, position and cropping are set for the whole section above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Outcome",
          "info": "Lead with the outcome, not the feature.",
          "default": "{{OUTCOME}}"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Supporting detail",
          "default": "<p>{{The feature that makes it true}}</p>"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "ECA LP — Benefits",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
{% stylesheet %}
.eca-lp-benefits{padding:3.5rem 1.5rem}
.eca-lp-wrap{max-width:1100px;margin:0 auto}
.eca-lp-h2{font-size:clamp(1.5rem,3vw,2.25rem);line-height:1.2;margin:0 0 1rem;text-align:center}
.eca-lp-intro{text-align:center;max-width:640px;margin:0 auto 2.5rem;opacity:.85}
.eca-lp-benefits__grid{display:grid;gap:2rem}
@media(min-width:750px){.eca-lp-benefits__grid--2{grid-template-columns:repeat(2,1fr)}.eca-lp-benefits__grid--3{grid-template-columns:repeat(3,1fr)}.eca-lp-benefits__grid--4{grid-template-columns:repeat(4,1fr)}}
.eca-lp-benefits__media{margin-bottom:.85rem}
.eca-lp-benefits__icon{width:var(--eca-ben-size,48px);height:var(--eca-ben-size,48px);object-fit:var(--eca-ben-fit,contain);border-radius:var(--eca-ben-radius,0);display:block;max-width:100%}
.eca-lp-benefits__ico{display:inline-flex;align-items:center;justify-content:center;width:var(--eca-ben-size,48px);height:var(--eca-ben-size,48px);border-radius:12px;background:rgba(127,127,127,.1)}
.eca-lp-benefits__ico svg{width:50%;height:50%}
.eca-lp-benefits__grid--mleft .eca-lp-benefits__item{display:flex;gap:1rem;align-items:flex-start}
.eca-lp-benefits__grid--mleft .eca-lp-benefits__media{flex:0 0 var(--eca-ben-size,48px);margin-bottom:0}
.eca-lp-benefits__grid--acenter .eca-lp-benefits__item{text-align:center}
.eca-lp-benefits__grid--acenter .eca-lp-benefits__media{margin-left:auto;margin-right:auto;width:max-content}
.eca-lp-benefits__grid--acenter.eca-lp-benefits__grid--mleft .eca-lp-benefits__item{text-align:left}
.eca-lp-benefits__title{font-size:1.15rem;margin:0 0 .5rem}
.eca-lp-benefits__body{opacity:.85;line-height:1.6}
.eca-lp-benefits .eca-lp-cta{text-align:center;margin-top:2.5rem}
{% endstylesheet %}
