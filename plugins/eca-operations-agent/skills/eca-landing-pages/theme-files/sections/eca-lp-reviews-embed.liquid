{%- comment -%}
  ECA LP — Reviews app embed. Uses the store's NATIVE review app rather than duplicating reviews.
  Paste the app's embed/shortcode, or add the app's own block in the theme editor.
{%- endcomment -%}
<section class="eca-lp-rev">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.embed != blank -%}
      <div class="eca-lp-rev__embed">{{ section.settings.embed }}</div>
    {%- else -%}
      {%- if request.design_mode -%}
        <p class="eca-lp-rev__hint">Add your review app's embed code in this section's settings, or drag the app block in here (Judge.me, Loox, Okendo, Yotpo, Stamped).</p>
      {%- endif -%}
    {%- endif -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Reviews embed", "tag": "section", "class": "eca-lp-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "liquid", "id": "embed", "label": "Review app embed", "info": "Paste your review app's embed/Liquid snippet, e.g. Judge.me or Loox." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "ECA LP — Reviews embed" }]
}
{% endschema %}
{% stylesheet %}
.eca-lp-rev{padding:3.5rem 1.5rem}
.eca-lp-rev__hint{text-align:center;opacity:.6;padding:2rem;border:1px dashed rgba(0,0,0,.2);border-radius:10px}
{% endstylesheet %}
