{%- comment -%} eca-lp-library v1.28.0 {%- endcomment -%}
{%- comment -%}
  ECA LP — Reviews app embed. Uses the store's NATIVE review app rather than duplicating reviews.
  Paste the app's embed/shortcode, or add the app's own block in the theme editor.
{%- endcomment -%}
{%- liquid
  assign eca_cls = ''
  if section.settings.color_scheme != blank
    assign eca_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign eca_sty = ''
  if section.settings.bg_color != blank
    assign eca_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign eca_sty = eca_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}
<section class="eca-lp-rev {{ eca_cls }}" style="{{ eca_sty }}">
  <div class="eca-lp-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="eca-lp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.embed != blank -%}
      <div class="eca-lp-rev__embed">{{ section.settings.embed }}</div>
    {%- else -%}
      {%- if request.design_mode -%}
        <div class="eca-lp-appslot">
          <p class="eca-lp-appslot__t">Add your review app's widget here</p>
          <p class="eca-lp-appslot__d">Either click <strong>Add block</strong> and pick your reviews app, or paste its embed snippet in this section's settings (Judge.me, Loox, Okendo, Yotpo, Stamped).</p>
        </div>
      {%- endif -%}
    {%- endif -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "ECA LP — Reviews embed",
  "tag": "section",
  "class": "eca-lp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "liquid",
      "id": "embed",
      "label": "Review app embed",
      "info": "Paste your review app's embed/Liquid snippet, e.g. Judge.me or Loox."
    },
    {
      "type": "header",
      "content": "Section colour"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Uses your theme's colour schemes so text and buttons stay readable. Leave as-is to inherit the page."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)",
      "info": "Overrides the scheme. Only use if you need an exact colour."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text (optional)"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "ECA LP — Reviews embed"
    }
  ]
}
{% endschema %}
{% stylesheet %}
.eca-lp-rev{padding:3.5rem 1.5rem}
.eca-lp-rev__hint{text-align:center;opacity:.6;padding:2rem;border:1px dashed rgba(0,0,0,.2);border-radius:10px}
.eca-lp-appslot{border:2px dashed rgba(0,0,0,.2);border-radius:12px;padding:2rem;text-align:center}
.eca-lp-appslot__t{font-weight:700;margin:0 0 .5rem}
.eca-lp-appslot__d{opacity:.7;margin:0;font-size:.9rem;max-width:460px;margin-inline:auto;line-height:1.6}
{% endstylesheet %}
