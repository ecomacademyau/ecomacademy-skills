{%- comment -%} eca-gift-guide library v1.0.0 {%- endcomment -%}
{%- liquid
  assign gg_cls = ''
  if section.settings.color_scheme != blank
    assign gg_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign gg_sty = ''
  if section.settings.bg_color != blank
    assign gg_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign gg_sty = gg_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}

{%- liquid
  assign gg_items = ''
  assign gg_n = 0
-%}
<section class="gg-grid-sec {{ gg_cls }}" style="{{ gg_sty }}padding-top:{{ section.settings.pad_top }}px;padding-bottom:{{ section.settings.pad_bottom }}px;" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="gg-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="gg-grid__h">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lead != blank -%}<div class="gg-grid__lead">{{ section.settings.lead }}</div>{%- endif -%}
    <ul class="gg-grid gg-grid--c{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          if p != blank
            assign gg_title = block.settings.title | default: p.title
            assign gg_url = p.url
            # An unset image_picker is not reliably nil, so `default:` can hand
            # image_url an empty value and render a broken image. Be explicit.
            if block.settings.image != blank
              assign gg_img = block.settings.image
            else
              assign gg_img = p.featured_image
            endif
            assign gg_price = p.price
            assign gg_avail = p.available
          else
            assign gg_title = block.settings.title
            assign gg_url = block.settings.url
            assign gg_img = block.settings.image
            assign gg_price = null
            assign gg_avail = true
          endif
        -%}
        {%- if gg_title != blank and gg_url != blank -%}
          {%- unless gg_avail == false and section.settings.hide_sold_out -%}
          <li class="gg-tile" {{ block.shopify_attributes }}>
            <a class="gg-tile__link" href="{{ gg_url }}">
              <span class="gg-tile__media">
                {%- if gg_img != blank -%}
                  {{ gg_img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200,400,600,800', class: 'gg-tile__img', alt: gg_title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'gg-tile__img gg-placeholder' }}
                {%- endif -%}
                {%- if gg_avail == false -%}<span class="gg-tile__flag">Sold out</span>{%- endif -%}
              </span>
              <span class="gg-tile__title">{{ gg_title }}</span>
              {%- if block.settings.note != blank -%}<span class="gg-tile__note">{{ block.settings.note }}</span>{%- endif -%}
              {%- if section.settings.show_price and gg_price != null -%}
                <span class="gg-tile__price">{{ gg_price | money }}</span>
              {%- endif -%}
            </a>
          </li>
          {%- liquid
            assign gg_n = gg_n | plus: 1
            assign gg_abs = gg_url
            unless gg_url contains '://'
              assign gg_abs = gg_url | prepend: request.origin
            endunless
            capture gg_entry
              echo '{"@type":"ListItem","position":'
              echo gg_n
              echo ',"name":'
              echo gg_title | json
              echo ',"url":'
              echo gg_abs | json
              echo '}'
            endcapture
            if gg_items == ''
              assign gg_items = gg_entry
            else
              assign gg_items = gg_items | append: ',' | append: gg_entry
            endif
          -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if section.settings.more_url != blank and section.settings.more_text != blank -%}
      <p class="gg-grid__more"><a href="{{ section.settings.more_url }}">{{ section.settings.more_text }}</a></p>
    {%- endif -%}
  </div>
</section>
{%- if gg_items != '' -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ItemList","name":{{ section.settings.heading | json }},"itemListElement":[{{ gg_items }}]}
</script>
{%- endif -%}
<style>
  .gg-grid__h{margin:0 0 .5rem}
  .gg-grid__lead{max-width:60ch;opacity:.85;margin:0 0 1rem}
  .gg-grid{list-style:none;margin:1.25rem 0 0;padding:0;display:grid;gap:1.25rem}
  .gg-grid--c2{grid-template-columns:repeat(2,1fr)}
  .gg-grid--c3{grid-template-columns:repeat(3,1fr)}
  .gg-grid--c4{grid-template-columns:repeat(4,1fr)}
  .gg-grid--c5{grid-template-columns:repeat(5,1fr)}
  .gg-tile__link{display:block;text-decoration:none;color:inherit}
  .gg-tile__media{display:block;position:relative;margin-bottom:.6rem}
  .gg-tile__img{width:100%;height:auto;display:block;border-radius:10px;aspect-ratio:1/1;object-fit:cover}
  .gg-tile__flag{position:absolute;left:.5rem;top:.5rem;background:currentColor;border-radius:4px;padding:.15rem .45rem;font-size:.75rem}
  .gg-tile__title{display:block;font-weight:600}
  .gg-tile__note{display:block;opacity:.8;font-size:.9rem;margin-top:.15rem}
  .gg-tile__price{display:block;opacity:.75;margin-top:.15rem}
  .gg-tile__link:hover .gg-tile__title{text-decoration:underline}
  .gg-grid__more{margin:1.25rem 0 0}
  @media (max-width:749px){.gg-grid{grid-template-columns:repeat(2,1fr) !important}}
</style>
{% schema %}
{
  "name": "ECA Gift Guide - Gift grid",
  "tag": "section",
  "class": "gg-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "One gift group. Add this section once per group - by recipient, by interest, or by price band."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Write it as something a person would search: 'The best gifts for someone who loves coffee', not 'Family & Friends'.",
      "default": "The best gifts for {{WHO}}"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Intro line"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id (optional)",
      "info": "Lets a quick-link tile jump straight to this section."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold-out products",
      "default": true,
      "info": "Leave on. A gift guide that links a sold-out product in December costs a customer, not a click."
    },
    {
      "type": "header",
      "content": "See-all link"
    },
    {
      "type": "paragraph",
      "content": "Write the link text as the thing itself - 'See all gifts for latte lovers'. 'See all' or 'Shop now' tells a reader and a search engine nothing."
    },
    {
      "type": "url",
      "id": "more_url",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "more_text",
      "label": "Link text",
      "default": "See all gifts for {{WHO}}"
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Prefer a colour scheme over the custom pickers - a scheme carries text and button colours together, so a dark band still has readable text."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text colour (optional)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "gift",
      "name": "Gift",
      "limit": 24,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Picking a product keeps the title, image, price and stock accurate by itself."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "note",
          "label": "One-line note",
          "info": "Why this suits the person. Optional."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Only needed if no product is picked."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ECA Gift Guide - Gift grid",
      "blocks": [
        {
          "type": "gift"
        },
        {
          "type": "gift"
        },
        {
          "type": "gift"
        }
      ]
    }
  ]
}
{% endschema %}
