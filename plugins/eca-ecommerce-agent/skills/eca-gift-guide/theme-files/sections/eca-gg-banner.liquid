{%- comment -%} eca-gift-guide library v1.0.0 {%- endcomment -%}
{%- liquid
  assign gg_cls = ''
  if section.settings.color_scheme != blank
    assign gg_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign gg_sty = ''
  if section.settings.bg_color != blank
    assign gg_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign gg_sty = gg_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}

{%- assign gg_has_img = false -%}
{%- if section.settings.image != blank or section.settings.show_placeholder -%}{%- assign gg_has_img = true -%}{%- endif -%}
<section class="gg-banner gg-banner--{{ section.settings.layout }} {{ gg_cls }}" style="{{ gg_sty }}padding-top:{{ section.settings.pad_top }}px;padding-bottom:{{ section.settings.pad_bottom }}px;">
  <div class="gg-wrap gg-banner__inner">
    {%- if gg_has_img and section.settings.layout != 'text' -%}
      <div class="gg-banner__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400,600,900,1200,1600', class: 'gg-banner__img', alt: section.settings.image_alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'gg-banner__img gg-placeholder' }}
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="gg-banner__txt">
      {%- if section.settings.eyebrow != blank -%}<p class="gg-banner__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- if section.settings.heading_is_h1 -%}
          <h1 class="gg-banner__h">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="gg-banner__h">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.body != blank -%}<div class="gg-banner__body">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a class="gg-btn" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .gg-wrap{max-width:1200px;margin:0 auto;padding:0 1.25rem}
  .gg-banner__inner{display:grid;gap:1.75rem;align-items:center}
  .gg-banner--split .gg-banner__inner{grid-template-columns:1fr 1fr}
  .gg-banner--split-right .gg-banner__inner{grid-template-columns:1fr 1fr}
  .gg-banner--split-right .gg-banner__media{order:2}
  .gg-banner--stacked .gg-banner__inner{grid-template-columns:1fr;text-align:center}
  .gg-banner--text .gg-banner__inner{grid-template-columns:1fr;text-align:center}
  .gg-banner__img{width:100%;height:auto;display:block;border-radius:10px}
  .gg-banner__eyebrow{margin:0 0 .4rem;text-transform:uppercase;letter-spacing:.08em;font-size:.8rem;opacity:.8}
  .gg-banner__h{margin:0 0 .6rem}
  .gg-banner__body{max-width:56ch;opacity:.9}
  .gg-banner--stacked .gg-banner__body,.gg-banner--text .gg-banner__body{margin-inline:auto}
  .gg-btn{display:inline-block;margin-top:1rem;padding:.8rem 1.6rem;border:1px solid currentColor;border-radius:999px;text-decoration:none;color:inherit;font-weight:600}
  @media (max-width:749px){.gg-banner__inner{grid-template-columns:1fr !important}.gg-banner--split-right .gg-banner__media{order:0}}
</style>
{% schema %}
{
  "name": "ECA Gift Guide - Banner",
  "tag": "section",
  "class": "gg-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The banner at the top of the guide. Use the H1 here - a page needs exactly one, and this is it."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Image left, text right"
        },
        {
          "value": "split-right",
          "label": "Image right, text left"
        },
        {
          "value": "stacked",
          "label": "Image above, text below"
        },
        {
          "value": "text",
          "label": "Text only"
        }
      ],
      "default": "split"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show a placeholder until an image is chosen",
      "default": true
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe the gift or the scene, not the layout."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Christmas Gift Guide"
    },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "This heading is the page H1",
      "default": true,
      "info": "Leave on. Turn it off only if another section on this page is already the H1."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Prefer a colour scheme over the custom pickers - a scheme carries text and button colours together, so a dark band still has readable text."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text colour (optional)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "ECA Gift Guide - Banner"
    }
  ]
}
{% endschema %}
