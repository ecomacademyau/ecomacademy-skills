{%- comment -%} eca-gift-guide library v1.0.0 {%- endcomment -%}
{%- liquid
  assign gg_cls = ''
  if section.settings.color_scheme != blank
    assign gg_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign gg_sty = ''
  if section.settings.bg_color != blank
    assign gg_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign gg_sty = gg_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}

<section class="gg-quick {{ gg_cls }}" style="{{ gg_sty }}padding-top:{{ section.settings.pad_top }}px;padding-bottom:{{ section.settings.pad_bottom }}px;">
  <div class="gg-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="gg-quick__h">{{ section.settings.heading }}</h2>{%- endif -%}
    <ul class="gg-quick__list gg-quick__list--{{ section.settings.style }} gg-quick__list--c{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign gg_url = block.settings.url
          assign gg_label = block.settings.label
          if block.settings.collection != blank
            if gg_url == blank
              assign gg_url = block.settings.collection.url
            endif
            if gg_label == blank
              assign gg_label = block.settings.collection.title
            endif
          endif
        -%}
        {%- if gg_url != blank -%}
        <li class="gg-quick__item" {{ block.shopify_attributes }}>
          <a class="gg-quick__link" href="{{ gg_url }}">
            {%- if section.settings.style == 'tiles' -%}
              <span class="gg-quick__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,400,600', class: 'gg-quick__img', alt: gg_label }}
                {%- elsif block.settings.collection.featured_image != blank -%}
                  {{ block.settings.collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,400,600', class: 'gg-quick__img', alt: gg_label }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'gg-quick__img gg-placeholder' }}
                {%- endif -%}
              </span>
            {%- endif -%}
            <span class="gg-quick__label">{{ gg_label }}</span>
          </a>
        </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
<style>
  .gg-quick__h{margin:0 0 1rem;text-align:center}
  .gg-quick__list{list-style:none;margin:0;padding:0;display:grid;gap:1rem}
  .gg-quick__list--c2{grid-template-columns:repeat(2,1fr)}
  .gg-quick__list--c3{grid-template-columns:repeat(3,1fr)}
  .gg-quick__list--c4{grid-template-columns:repeat(4,1fr)}
  .gg-quick__list--c5{grid-template-columns:repeat(5,1fr)}
  .gg-quick__list--c6{grid-template-columns:repeat(6,1fr)}
  .gg-quick__list--buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem}
  .gg-quick__link{display:block;text-decoration:none;color:inherit;text-align:center}
  .gg-quick__list--buttons .gg-quick__link{border:1px solid currentColor;border-radius:999px;padding:.6rem 1.2rem;font-weight:600}
  .gg-quick__media{display:block;margin-bottom:.5rem}
  .gg-quick__img{width:100%;height:auto;display:block;border-radius:10px;aspect-ratio:1/1;object-fit:cover}
  .gg-quick__label{font-weight:600}
  .gg-quick__list--tiles .gg-quick__link:hover .gg-quick__label{text-decoration:underline}
  @media (max-width:749px){
    .gg-quick__list--tiles{grid-template-columns:repeat(2,1fr) !important}
  }
</style>
{% schema %}
{
  "name": "ECA Gift Guide - Quick links",
  "tag": "section",
  "class": "gg-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Tiles or buttons at the top that send people straight into the right collection. Label them the way a shopper would say it - 'Gifts for latte lovers', not 'Collection 3'."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by who it's for"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "tiles",
          "label": "Tiles with images"
        },
        {
          "value": "buttons",
          "label": "Text buttons"
        }
      ],
      "default": "tiles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Prefer a colour scheme over the custom pickers - a scheme carries text and button colours together, so a dark band still has readable text."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text colour (optional)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "limit": 12,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Picking a collection fills the label, image and link. Override any of them below."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ECA Gift Guide - Quick links",
      "blocks": [
        {
          "type": "link"
        },
        {
          "type": "link"
        },
        {
          "type": "link"
        },
        {
          "type": "link"
        }
      ]
    }
  ]
}
{% endschema %}
