{%- comment -%} eca-gift-guide library v1.0.0 {%- endcomment -%}
{%- liquid
  assign gg_cls = ''
  if section.settings.color_scheme != blank
    assign gg_cls = 'color-' | append: section.settings.color_scheme | append: ' gradient'
  endif
  assign gg_sty = ''
  if section.settings.bg_color != blank
    assign gg_sty = 'background:' | append: section.settings.bg_color | append: ';'
  endif
  if section.settings.text_color != blank
    assign gg_sty = gg_sty | append: 'color:' | append: section.settings.text_color | append: ';'
  endif
-%}

<section class="gg-seo {{ gg_cls }}" style="{{ gg_sty }}padding-top:{{ section.settings.pad_top }}px;padding-bottom:{{ section.settings.pad_bottom }}px;">
  <div class="gg-wrap gg-seo__wrap gg-seo__wrap--{{ section.settings.columns }}">
    {%- if section.settings.heading != blank -%}<h2 class="gg-seo__h">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="gg-seo__intro">{{ section.settings.intro }}</div>{%- endif -%}
    <div class="gg-seo__cols">
      {%- for block in section.blocks -%}
        <div class="gg-seo__part" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h3 class="gg-seo__sub">{{ block.settings.heading }}</h3>{%- endif -%}
          <div class="gg-seo__body">{{ block.settings.body }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .gg-seo__h{margin:0 0 .5rem}
  .gg-seo__intro{max-width:70ch;opacity:.9}
  .gg-seo__cols{margin-top:1.25rem;display:grid;gap:1.5rem}
  .gg-seo__wrap--2 .gg-seo__cols{grid-template-columns:repeat(2,1fr)}
  .gg-seo__sub{margin:0 0 .4rem;font-size:1.05rem}
  .gg-seo__body{max-width:70ch;opacity:.9}
  .gg-seo__body p{margin:0 0 .75rem}
  @media (max-width:749px){.gg-seo__cols{grid-template-columns:1fr !important}}
</style>
{% schema %}
{
  "name": "ECA Gift Guide - About these gifts (SEO)",
  "tag": "section",
  "class": "gg-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The prose at the foot of the page: a paragraph per gift group saying who it suits and why, naming the products. This is most of what the page has to rank on, and most of what an answer engine can quote. Write it for a person - a reader who finds it useful is the same signal a search engine is looking for."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About these Christmas gifts"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Layout",
      "options": [
        {
          "value": "1",
          "label": "One column"
        },
        {
          "value": "2",
          "label": "Two columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "paragraph",
      "content": "Prefer a colour scheme over the custom pickers - a scheme carries text and button colours together, so a dark band still has readable text."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background (optional)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom text colour (optional)"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Paragraph",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Sub-heading",
          "info": "Match the gift group above it, so a reader skimming can find the bit they want."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Text",
          "info": "Name the actual products and say who each suits. Do not repeat the heading back as a keyword."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ECA Gift Guide - About these gifts (SEO)",
      "blocks": [
        {
          "type": "part"
        },
        {
          "type": "part"
        },
        {
          "type": "part"
        }
      ]
    }
  ]
}
{% endschema %}
